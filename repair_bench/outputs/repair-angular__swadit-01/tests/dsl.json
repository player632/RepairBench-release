   "id": "F04",
   "kind": "static",
   "partition": "F2P",
   "source_ac_id": "D04",
   "title": "the source page shows the document in the YAML form it was loaded from",
   "setup": [
    {
     "action": "goto",
     "target": "/source"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 2600
    },
    {
     "action": "wait",
     "target": "page",
     "value": 1600
    },
    {
     "action": "js_eval",
     "target": "page",
     "expr": "(function(){var b=document.querySelectorAll('.editor-header button');for(var i=0;i<b.length;i++){if((b[i].textContent||'').replace(/\\s+/g,' ').trim()==='Validate'){b[i].click();return 'clicked';}}return 'validate-button-not-found';})()"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 1200
    }
   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "window.__SWADIT__.sourceFirstLineKind()",
     "expected": "YAML"
    },
    {
     "type": "js_eval",
     "target": "page",
     "expr": "window.__SWADIT__.sourceEditorCount()",
     "expected": 1
    },
    {
     "type": "js_eval",
     "target": "page",
     "expr": "window.__SWADIT__.sourceValidationMark()",
     "expected": "passed"
    },
    {
     "type": "js_eval",
     "target": "page",
     "expr": "window.__SWADIT__.locationPathname()",
     "expected": "/source"
    }
   ]
  },
