new file mode 100644
--- /dev/null
+++ b/.env.production
@@ -0,0 +1,25 @@
+# RepairBench adaptation for repair-vue__ocular-01 - the ONLY environment change this task makes.
+#
+# WHY THIS FILE: vite.config.ts:21 sets envPrefix ['OCULAR_'] and 'vite build' (package.json:16,
+# 'vue-tsc -b && vite build') defaults to mode production, so this is the file the seed itself reads
+# for a production build. It carries no secret and no host: it only selects the offline configuration
+# the seed already documents and already ships publicly.
+#
+# OCULAR_HYBRID_MODE=true  -> App.vue:97-100 loads the seed's own demo dataset when location.hash is
+#   exactly '#demo'; ChartPlaceholder.vue:11 and ToolsButton.vue:13 expose their offline branches.
+#   Belt-and-braces: with OCULAR_GENESIS_HOST unset the first half of that condition is already true.
+# DELIBERATELY ABSENT:
+#   OCULAR_GENESIS_HOST - would point the app at a backend. useStorage.ts:138 only calls login() when
+#     it is set, and src/store/genesis/genesis.sdk.ts:67 is then the one place that could reach the
+#     network. Leaving it unset is what makes the zero-egress sentinel a measurement, not a hope, and
+#     it is what keeps the cloud control disabled-and-idle BY DESIGN (see instruction.md item 8).
+#   OCULAR_BASE_URL - vite.config.ts:10 derives `base` from it. Setting it would rewrite every asset
+#     url and break the static serve this task is measured through. base stays '/'.
+#   OCULAR_TEST_USERNAME / OCULAR_TEST_PASSWORD - pre-filled login credentials (.env.example:10-12);
+#     there is nothing to log into here, so they are not shipped.
+# BUILD METADATA: fixed literals, never a run date. main.ts:15 prints new Date(OCULAR_BUILD_DATE), so
+#   a generated timestamp would put a moving value into the bundle; env.d.ts:12-15 declares all three.
+OCULAR_HYBRID_MODE=true
+OCULAR_BUILD_VERSION=repair-bench
+OCULAR_BUILD_SHA=0000000
+OCULAR_BUILD_DATE=2022-03-24T17:38:03.000Z
