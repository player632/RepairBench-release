@@ -0,0 +1,37 @@
+/*
+ * RB-OFFLINE (adaptation): local stand-in for the remote stylesheet that
+ * index.html used to pull from https://www.w3schools.com/w3css/4/w3.css.
+ *
+ * The repair environment has no network access, so the remote sheet can never
+ * be fetched; leaving the <link> in place costs a failed request on every load
+ * (and the two failed sub-resources are the only page errors this seed logs).
+ *
+ * Scope of this file is deliberately minimal. Only the three state/indicator
+ * classes that the application itself toggles or relies on for meaning are
+ * reproduced, and only with colour declarations:
+ *
+ *   .w3-blue-gray  - added to the selected navigation tab by setTab()
+ *   .w3-red        - the destructive "Reset" button in the settings panel
+ *   .w3-text-gray  - the "Required: ..." hint row inside each category table
+ *
+ * No layout, box-model, display or visibility rule from the upstream sheet is
+ * reproduced on purpose: the seed's own css/styles.css and css/dark.css already
+ * carry every rule the layout depends on (.w3-bar-item sizing, .progress-bar,
+ * .hidden / .hiddenTask, .panel, .inline, .tooltip), and re-introducing the
+ * upstream layout rules would change the rendered geometry of the offline build
+ * away from the one the seed's own stylesheets produce.
+ */
+
+.w3-blue-gray {
+    color: #ffffff !important;
+    background-color: #607d8b !important;
+}
+
+.w3-red {
+    color: #ffffff !important;
+    background-color: #f44336 !important;
+}
+
+.w3-text-gray {
+    color: #9e9e9e !important;
+}
