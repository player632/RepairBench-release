   ngAfterViewInit(): void {
 
@@ -106,6 +106,27 @@ export class FabricjsEditorComponent implements AfterViewInit {
       const canvasElement: any = document.getElementById('canvas');
     });
 
+    // Repair-Bench instrumentation: DOM-side probe surface for canvas-state
+    // assertions (canvas pixels are never asserted; every check reads the
+    // fabric object model). select(i) activates object i through the
+    // component's own 'object:selected' handler - fabric >= 2 no longer
+    // emits that legacy canvas event, so the probe fires it explicitly
+    // inside the Angular zone to refresh the selection panels/bindings.
+    (window as any).fab = {
+      canvas: this.canvas,
+      component: this,
+      select: (i: number) => {
+        const c: any = this.canvas;
+        const obj = c.getObjects()[i];
+        if (!obj) { return 'no-object:' + i; }
+        return this.zone.run(() => {
+          c.discardActiveObject();
+          c.setActiveObject(obj);
+          c.fire('object:selected', { target: obj });
+          return 'selected:' + i;
+        });
+      }
+    };
   }
 
 
