diff --git a/resources/css/material-icons-offline.css b/resources/css/material-icons-offline.css
new file mode 100644
index 0000000..c81defa
--- /dev/null
+++ b/resources/css/material-icons-offline.css
@@ -0,0 +1,34 @@
+/* Offline inert stand-in for the third-party icon webfont stylesheet the pristine entry document
+   pulled from a CDN. Added by the harness (environment/adaptation.patch), not by the author.
+
+   What this file deliberately does NOT contain:
+     - no @font-face rule, so the browser has nothing to fetch: the served face makes zero requests
+       to any host other than the loopback address it is served from;
+     - no downloaded or vendored glyph artwork, and no invented artwork either.
+
+   What it does contain is only the box-metrics half of the upstream icon rule, so the three icon
+   slots in the entry document keep their inline-box geometry, their line box and their direction
+   and stay exactly where the page puts them. The font stack is 'inherit' on purpose: each slot
+   keeps its own ligature word ("settings", "help_outline", "warning_amber") as plain text, which is
+   the honest text stand-in - the words were already the document's own content, so nothing had to be
+   drawn or downloaded to replace them. Font size is inherited rather than pinned to the upstream
+   24px so a word does not blow the slot up to icon-glyph size.
+
+   Consequence for verification, stated so nobody asserts on it later: glyph shape, glyph identity
+   and font family are NOT observable on this face and no checkpoint reads them. Every assertion in
+   tests/dsl.json reads text, a value, an attribute, an element count, a computed style the page sets
+   itself, or a scalar returned by a read-only handle. */
+.material-icons {
+    font-family: inherit;
+    font-weight: normal;
+    font-style: normal;
+    font-size: inherit;
+    display: inline-block;
+    line-height: 1;
+    letter-spacing: normal;
+    text-transform: none;
+    white-space: nowrap;
+    word-wrap: normal;
+    direction: ltr;
+    -webkit-font-smoothing: antialiased;
+}
