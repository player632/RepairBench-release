+    },
+    libsPresent: function () {
+      return document.querySelectorAll('script[src]').length + '|' + (typeof Sat === 'function' ? 1 : 0);
+    },
+    probeCount: function () { return document.querySelectorAll('[data-testid]').length; },
+    storageKeys: function () { try { return Object.keys(localStorage).sort().join(','); } catch (e) { return 'ERR'; } },
+    sessionKeys: function () { try { return Object.keys(sessionStorage).sort().join(','); } catch (e) { return 'ERR'; } },
+    cookieText: function () { return String(document.cookie || ''); },
+    urlPath: function () { return location.pathname; },
+    urlQuery: function () { return location.search + location.hash; },
+    rbGlobals: function () { return Object.keys(window).filter(function (k) { return k.indexOf('__rb') === 0; }).length; }
+  };
+  Object.defineProperty(window, '__rb_kaboom', {
+    value: Object.freeze(api), enumerable: true, writable: false, configurable: false
