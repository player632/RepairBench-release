+/* ---- RepairBench verification facade (instrumentation only; strictly read-only) ----
+   Every member below is a PURE READ of the document, the computed style, the two storage
+   objects or the page's own game instance. There is no setter, nothing is cached and nothing
+   is written anywhere, and the object is frozen, so a candidate fix cannot be rewarded for
+   satisfying these handles instead of fixing the game. The object is enumerable on purpose:
+   the state-isolation sentinel enumerates window and must be able to see the ONE global the
+   harness added. Appended after the seed's own boot click so it cannot change boot order. */
+(function () {
+  function rows() { return Array.prototype.slice.call(document.querySelectorAll('.board-row')); }
+  function cellAt(x, y) { var r = rows()[y]; if (!r) { return null; } return r.querySelectorAll('.cell')[x] || null; }
+  function cells() { return Array.prototype.slice.call(document.querySelectorAll('.cell')); }
+  function hasToken(c, k) { return (' ' + c.className + ' ').indexOf(' ' + k + ' ') >= 0; }
+  function cnt(k) { return cells().filter(function (c) { return hasToken(c, k); }).length; }
+  function stateEl() { var b = document.getElementById('board'); return b ? b.nextElementSibling : null; }
+  function glyph(x, y, pseudo) {
+    var c = cellAt(x, y); if (!c) { return null; }
+    var v = getComputedStyle(c, pseudo).content;
+    if (v === null || v === undefined || v === 'none') { return ''; }
+    return String(v).replace(/^"|"$/g, '');
+  }
+  function byId(id) { return document.getElementById(id); }
+  function hintEl() { return byId('hint'); }
+  function norm(s) { return String(s === null || s === undefined ? '' : s).replace(/\s+/g, ' ').trim(); }
+  var api = {
+    rows: function () { return rows().length; },
+    cols: function () { var r = rows()[0]; return r ? r.querySelectorAll('.cell').length : 0; },
+    countClass: function (k) { return cnt(k); },
+    cellClass: function (x, y) { var c = cellAt(x, y); return c ? c.className : null; },
+    cellGlyph: function (x, y) { return glyph(x, y, '::after'); },
+    cellBeforeGlyph: function (x, y) { return glyph(x, y, '::before'); },
+    cellUserSelect: function (x, y) { var c = cellAt(x, y); return c ? String(getComputedStyle(c).getPropertyValue('user-select')).trim() : null; },
+    cellFontSize: function (x, y) { var c = cellAt(x, y); return c ? String(getComputedStyle(c).getPropertyValue('font-size')).trim() : null; },
+    cellPosition: function (x, y) { var c = cellAt(x, y); return c ? String(getComputedStyle(c).getPropertyValue('position')).trim() : null; },
+    cellBox: function (x, y) {
+      var c = cellAt(x, y); if (!c) { return null; }
+      var s = getComputedStyle(c);
+      return String(s.getPropertyValue('width')).trim() + 'x' + String(s.getPropertyValue('height')).trim();
+    },
+    labelOf: function (x, y) {
+      var c = cellAt(x, y); if (!c) { return null; }
+      var m = /(?:^| )label-(-?[0-9]+)(?: |$)/.exec(c.className);
+      return m ? parseInt(m[1], 10) : null;
+    },
+    stateText: function () { var e = stateEl(); return e ? e.textContent : null; },
+    debugMarker: function () { var t = api.stateText(); return !!t && t.indexOf(', boundary:') >= 0; },
+    hintVisible: function () { var h = hintEl(); return h ? !h.classList.contains('hidden') : null; },
+    hintOpacity: function () { var h = hintEl(); return h ? Number(getComputedStyle(h).opacity) : null; },
+    hintText: function () { var h = hintEl(); return h ? norm(h.innerText) : null; },
+    hintTextChanged: function () { return api.hintText() !== 'Hello, world'; },
+    hintSafeCount: function () { return cnt('hint-safe'); },
+    hintMineCount: function () { return cnt('hint-mine'); },
+    hintUnknownCount: function () { return cnt('hint-unknown'); },
+    undoDisabled: function () { var u = byId('undo'); return u ? !!u.disabled : null; },
+    undoBtnText: function () { var u = byId('undo'); return u ? norm(u.textContent) : null; },
+    hintBtnText: function () { var b = byId('rb-hint-btn'); return b ? norm(b.textContent) : null; },
+    minesMax: function () { var e = byId('numMines'); return e ? String(e.max) : null; },
+    inputValue: function (id) { var e = byId(id); return e ? String(e.value) : null; },
+    inputType: function (id) { var e = byId(id); return e ? String(e.type) : null; },
+    formValid: function () { var f = byId('form'); return f ? f.checkValidity() : null; },
+    settingChecked: function (n) { var e = byId(n); return e ? !!e.checked : null; },
+    settingType: function (n) { var e = byId(n); return e ? String(e.type) : null; },
+    optLabelTag: function (n) { var e = byId(n); return e && e.parentElement ? e.parentElement.tagName : null; },
+    optionsInitial: function () {
+      return ['debug', 'allowOutside', 'safeMode', 'countdownMode'].map(function (n) {
