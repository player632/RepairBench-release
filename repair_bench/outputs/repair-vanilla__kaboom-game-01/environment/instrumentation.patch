+    rulesNestedCount: function () { return document.querySelectorAll('[data-testid="rb-rules-list"] ul li').length; },
+    mainLinkCount: function () { return document.querySelectorAll('main a[href]').length; },
+    presetTexts: function () {
+      return Array.prototype.slice.call(document.querySelectorAll('#rb-preset-1,#rb-preset-2,#rb-preset-3,#rb-preset-4'))
