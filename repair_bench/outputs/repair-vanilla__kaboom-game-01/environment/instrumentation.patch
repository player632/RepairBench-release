+    docTitle: function () { return document.title; },
+    aboutHeading: function () { var h = document.querySelectorAll('h2')[0]; return h ? norm(h.textContent) : null; },
+    seeAlsoHeading: function () { var h = document.querySelectorAll('h2')[1]; return h ? norm(h.textContent) : null; },
+    rulesFirstText: function () { var l = document.querySelector('[data-testid="rb-rules-list"] > li'); return l ? norm(l.textContent) : null; },
