+    s.toolCount = toolEls().length;
+    s.extrudeMode = str(settings.extrudeMode || "");
+    var exSel = q(".extrude.selected");
+    s.extrudeSelectedType = exSel ? str(exSel.getAttribute("type")) : "";
+
+    // pointer / interaction state
