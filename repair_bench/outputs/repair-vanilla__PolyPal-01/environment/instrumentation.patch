+    s.selectedColorIndex = num(rd("selectedColorIndex", -1), -1);
+    s.selectedColorWrapperCount = qa(".colors .color-wrapper.selected").length;
+
+    // tools / mode
+    s.selectedTool = str(rd("selectedTool", ""));
+    s.canvasToolAttr = canvasEl() ? str(canvasEl().getAttribute("tool")) : "";
+    var tsel = q(".tools .tool.selected");
