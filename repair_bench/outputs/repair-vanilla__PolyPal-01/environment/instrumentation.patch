+//
+//
+// NOT PART OF THE APPLICATION. This file is added by environment/instrumentation.patch
+// and is loaded last, after every application script, so all of the editor's state is
+// already declared when it runs.
+//
+// PolyPal declares its state with top-level `let` / `const` in classic (non-module)
+// scripts. Those bindings live in the GLOBAL LEXICAL environment: they are reachable by
+// BARE NAME from any script in the same realm, but they are NOT properties of `window`
+// (`window.grids` is undefined). Every reader below therefore goes through indirect eval
+// on the bare identifier, guarded by a `typeof` probe, and falls back to a sentinel when
+// the binding is missing. Nothing here is allowed to throw into the application.
+//
+// Two surfaces are exported:
+//   window.__PPQ__()  - PURE READ. Returns one flat object of scalars (numbers, strings,
+//                       booleans) plus `frozen`, a map of tagged snapshots. Grading
+//                       assertions call this and compare scalars only. It never clicks,
+//                       types, dispatches, mutates application state or reads the clock.
+//   window.__PPX__    - SETUP ONLY. Deterministic fixtures and real in-page interactions
+//                       (real MouseEvent / KeyboardEvent / Event dispatch on the real
+//                       elements, and real clicks on the real buttons, swatches, tools and
+//                       sliders). Every side effect a checkpoint needs happens here, before
+//                       the assertions run, because assertions are polled for ~9s and must
+//                       stay pure.
+(function () {
+  "use strict";
+
+  var DEF6 = ["#8F3D61", "#B94B5D", "#DD7E5F", "#EB9762", "#EDBD77", "#DDDDDD"];
+
+  // ---- bare-name global readers (lexical globals, not window properties) ----
+  function rd(name, dflt) {
+    try {
+      if ((0, eval)("typeof " + name) === "undefined") return dflt;
+      return (0, eval)(name);
+    } catch (e) { return dflt; }
+  }
+  function callGlobal(name, args) {
+    try {
+      var fn = rd(name, null);
+      if (typeof fn !== "function") return "ERR:no-function:" + name;
+      return fn.apply(null, args || []);
+    } catch (e) { return "ERR:" + String((e && e.message) || e); }
+  }
+
+  // ---- DOM helpers (prefer the injected probes, fall back to the app selectors) ----
+  function q(sel) { try { return document.querySelector(sel); } catch (e) { return null; } }
+  function qa(sel) { try { return Array.prototype.slice.call(document.querySelectorAll(sel)); } catch (e) { return []; } }
+  function tid(id, fallback) { return q('[data-testid="' + id + '"]') || q(fallback); }
+  function tidAll(bar, sel) {
+    var root = q('[data-testid="' + bar + '"]');
+    if (root) return Array.prototype.slice.call(root.querySelectorAll(sel));
+    return qa(sel);
+  }
+  function canvasEl() { return tid("pp-svg-canvas", ".svg-canvas"); }
+  function imageEl() { return tid("pp-svg-image", ".svg-image"); }
+  function pointsEl() { return tid("pp-svg-points", ".svg-points"); }
+  function polygons() { var r = imageEl(); return r ? Array.prototype.slice.call(r.querySelectorAll("polygon")) : []; }
+  function uiPolygons() { var r = pointsEl(); return r ? Array.prototype.slice.call(r.querySelectorAll("polygon")).filter(function (el) { return el.hasAttribute("stroke-linejoin"); }) : []; } // grid UI faces only: the app parks its own drag-marquee polygon there (index.js drawDragZone) and it carries no stroke-linejoin
+  function pointGroups() { var r = pointsEl(); return r ? Array.prototype.slice.call(r.querySelectorAll("svg")) : []; }
+  function colorWrappers() { return tidAll("pp-colors-bar", ".colors .color-wrapper"); }
+  function swatches() { return tidAll("pp-colors-bar", ".colors .swatch"); }
+  function pickers() { return tidAll("pp-colors-bar", ".colors .colorpicker-wrapper"); }
+  function pickerInputs() { return tidAll("pp-colors-bar", ".colors .colorpicker"); }
+  function toolEls() { return tidAll("pp-tools-bar", ".tools .tool"); }
+  function sliderEl(which) {
+    if (which === "rotate") return tid("pp-slider-rotate", ".bottom-ui .rotate");
+    return tid("pp-slider-scale", ".bottom-ui .scale");
+  }
+  function btnEl(which) {
+    var map = {
+      save: ["pp-btn-save", ".save"], load: ["pp-btn-load", ".load"], reset: ["pp-btn-reset", ".reset"],
+      download: ["pp-btn-download", ".download"], undo: ["pp-btn-undo", ".undo"], del: ["pp-btn-delete", ".delete"],
+      zup: ["pp-btn-z-up", ".z-up"], zdown: ["pp-btn-z-down", ".z-down"],
+      extrudeLine: ["pp-btn-extrude-line", ".extrude[type='line']"],
+      extrudePoint: ["pp-btn-extrude-point", ".extrude[type='point']"]
