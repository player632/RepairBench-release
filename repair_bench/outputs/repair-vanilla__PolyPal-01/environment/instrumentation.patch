+    s.histLenGe1 = hist.length >= 1;
+    s.histLenGe2 = hist.length >= 2;
+
+    // palette
+    s.paletteLen = cols.length;
+    s.paletteJoin = cols.map(str).join("|");
+    for (var ci = 0; ci < 8; ci++) s["paletteAt" + ci] = (ci < cols.length) ? str(cols[ci]) : "";
+    var sw = swatches();
+    s.swatchCount = sw.length;
+    s.swatchColorAttrJoin = sw.map(function (el) { return str(el.getAttribute("color")); }).join("|");
+    s.swatchColorAttr2 = sw[2] ? str(sw[2].getAttribute("color")) : "";
