+    s.mouseY = num(mouse.y, -1);
+    s.mousePressed = !!mouse.pressed;
+    s.mousePressedAnywhere = !!mouse.pressedAnywhere;
+    s.mouseDragging = !!mouse.dragging;
+    s.shiftPressed = !!mouse.shiftPressed;
+    s.snapshotTakenTrue = rd("snapshotTaken", null) === true;
+    s.clonedGridPresent = !!(cloned && cloned.grid);
+    s.clonedGridMode = (cloned && cloned.grid) ? str(cloned.grid.mode || "") : "";
