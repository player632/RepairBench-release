+    var m = map[which];
+    return m ? tid(m[0], m[1]) : null;
+  }
+
+  // ---- canonical geometry: rounded integers, sorted numerically by x then y ----
+  function canon(list) {
+    if (!list || !list.length) return "";
+    var pairs = [];
+    for (var i = 0; i < list.length; i++) {
+      var p = list[i];
+      if (!p || typeof p.x !== "number" || typeof p.y !== "number") return "ERR:bad-point";
+      pairs.push([Math.round(p.x), Math.round(p.y)]);
+    }
+    pairs.sort(function (a, b) { return (a[0] - b[0]) || (a[1] - b[1]); });
+    var out = [];
+    for (var j = 0; j < pairs.length; j++) out.push("(" + pairs[j][0] + "," + pairs[j][1] + ")");
+    return out.join("|");
+  }
+  function extent(list, key, wantMax) {
+    if (!list || !list.length) return -1;
+    var v = Math.round(list[0][key]);
+    for (var i = 1; i < list.length; i++) {
+      var c = Math.round(list[i][key]);
+      if (wantMax ? c > v : c < v) v = c;
+    }
+    return v;
+  }
+  function num(v, dflt) { return (typeof v === "number" && isFinite(v)) ? v : dflt; }
+  function str(v) { return (v === null || v === undefined) ? "" : String(v); }
+
+  // ---- fixtures -------------------------------------------------------------
+  // Every fixture pins the six default colours so that a picture round-trip can never
+  // be confused with a palette round-trip: the palette faces are asserted separately.
+  function sq(x0, y0, x1, y1) {
+    return [{ x: x0, y: y0 }, { x: x1, y: y0 }, { x: x1, y: y1 }, { x: x0, y: y1 }];
+  }
+  function pic(grids) { return { grids: grids, colors: DEF6.slice() }; }
+  var FIXTURES = {
+    // one triangle, colour 0
+    tri: function () {
+      return pic([{ points: [{ x: 100, y: 100 }, { x: 300, y: 100 }, { x: 300, y: 300 }], fillColorIndex: 0 }]);
+    },
+    // one quadrilateral, colour 0
+    square: function () {
+      return pic([{ points: sq(300, 250, 460, 410), fillColorIndex: 0 }]);
+    },
+    // two overlapping squares: z-order is the observable (grid 0 under grid 1)
+    overlap: function () {
+      return pic([
+        { points: sq(100, 100, 260, 260), fillColorIndex: 0 },
+        { points: sq(180, 180, 340, 340), fillColorIndex: 1 }
+      ]);
+    },
+    // two disjoint squares with caller-chosen colour indexes
+    pair: function (a, b) {
+      return pic([
+        { points: sq(100, 100, 260, 260), fillColorIndex: num(a, 0) },
+        { points: sq(400, 100, 560, 260), fillColorIndex: num(b, 0) }
+      ]);
+    },
+    // triangle + disjoint square, different colour indexes (7 distinct vertices)
+    triq: function () {
+      return pic([
+        { points: [{ x: 100, y: 100 }, { x: 300, y: 100 }, { x: 300, y: 300 }], fillColorIndex: 0 },
+        { points: sq(500, 150, 660, 310), fillColorIndex: 3 }
+      ]);
+    }
+  };
+
+  // ---- events ---------------------------------------------------------------
+  function mev(type, x, y) {
+    return new MouseEvent(type, {
+      bubbles: true, cancelable: true, view: window,
+      clientX: x, clientY: y, screenX: x, screenY: y, button: 0, buttons: type === "mouseup" ? 0 : 1
+    });
+  }
+  function send(el, ev) { if (!el) return "ERR:no-element"; try { el.dispatchEvent(ev); return "ok"; } catch (e) { return "ERR:" + String((e && e.message) || e); } }
+  function keyEv(type, code) {
+    var ev = new KeyboardEvent(type, { bubbles: true, cancelable: true, view: window, key: "Shift" });
+    try { Object.defineProperty(ev, "keyCode", { get: function () { return code; } }); } catch (e) { /* ignore */ }
+    try { Object.defineProperty(ev, "which", { get: function () { return code; } }); } catch (e) { /* ignore */ }
+    return ev;
+  }
+
+  // ---- frozen snapshots ------------------------------------------------------
+  var frozen = {};
+  var baselineGlobals = [];
+
+  // ---- PURE READ snapshot ----------------------------------------------------
+  function snapshot() {
+    var pts = rd("points", null); pts = (pts && pts.length !== undefined) ? pts : [];
+    var grs = rd("grids", null); grs = (grs && grs.length !== undefined) ? grs : [];
+    var cols = rd("availableColors", null); cols = (cols && cols.length !== undefined) ? cols : [];
+    var hist = rd("pictureHistory", null); hist = (hist && hist.length !== undefined) ? hist : [];
+    var mouse = rd("mouse", {}) || {};
+    var settings = rd("settings", {}) || {};
+    var cloned = rd("clonedGrid", null);
+    var s = {};
+
+    s.ready = !!(canvasEl() && num(rd("frameCount", 0), 0) >= 1);
+    s.probeVersion = 1;
+
+    // geometry
+    s.pointCount = pts.length;
+    s.gridCount = grs.length;
+    s.canonPoints = canon(pts);
+    s.maxPointX = extent(pts, "x", true);
+    s.minPointX = extent(pts, "x", false);
+    s.maxPointY = extent(pts, "y", true);
+    s.minPointY = extent(pts, "y", false);
+    s.selectedPointCount = pts.filter(function (p) { return !!p.selected; }).length;
+    s.selectedGridCount = grs.filter(function (g) { return !!g.selected; }).length;
+
+    // per-grid faces (grid index == creation order == DOM order in this editor)
+    function gridAt(i) { return (i < grs.length) ? grs[i] : null; }
+    function gridPoints(i) { var g = gridAt(i); return (g && g.points) ? g.points : []; }
+    s.grid0PointCount = gridAt(0) ? gridPoints(0).length : -1;
+    s.grid1PointCount = gridAt(1) ? gridPoints(1).length : -1;
+    s.grid0Canon = gridAt(0) ? canon(gridPoints(0)) : "";
+    s.grid1Canon = gridAt(1) ? canon(gridPoints(1)) : "";
+    s.grid0MinX = extent(gridPoints(0), "x", false);
+    s.grid1MinX = extent(gridPoints(1), "x", false);
+    s.grid0MinY = extent(gridPoints(0), "y", false);
+    s.grid1MinY = extent(gridPoints(1), "y", false);
+    s.grid0MaxX = extent(gridPoints(0), "x", true);
+    s.grid1MaxX = extent(gridPoints(1), "x", true);
+    s.fillColorIndexJoin = grs.map(function (g) { return str(g.fillColorIndex); }).join(",");
+    s.fillIndexOfGrid0 = gridAt(0) ? num(gridAt(0).fillColorIndex, -1) : -1;
+    s.fillIndexOfGrid1 = gridAt(1) ? num(gridAt(1).fillColorIndex, -1) : -1;
+    s.fillOfGrid0 = gridAt(0) ? str(cols[num(gridAt(0).fillColorIndex, -1)]) : "";
+    s.fillOfGrid1 = gridAt(1) ? str(cols[num(gridAt(1).fillColorIndex, -1)]) : "";
+    s.zIndexJoin = grs.map(function (g) { return str(num(g.zIndex, -1)); }).join(",");
+    s.modeJoin = grs.map(function (g) { return str(g.mode || ""); }).join(",");
