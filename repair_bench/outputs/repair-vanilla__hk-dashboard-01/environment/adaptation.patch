+<script>
+/* [ADAPTATION] clock pin — determinism for 82 clock reads (59 in holidays.js).
+   Local-time construction so getDay()/getHours() are host-TZ independent.
+   Frozen instant: 2026-03-07T10:30:00 local (SATURDAY, inside the 07:00-18:00 collection window).
+   Saturday is deliberate: D01 narrows the collection-day upper bound 6->5, which is only
+   observable when getDay()===6; a Thursday pin would leave D01 with zero observable face. */
+(function () {
+  var FIXED = [2026, 2, 7, 10, 30, 0, 0];
+  var NativeDate = Date;
+  var fixedMs = new NativeDate(FIXED[0], FIXED[1], FIXED[2], FIXED[3], FIXED[4], FIXED[5], FIXED[6]).getTime();
+  function FrozenDate(y, mo, d, h, mi, s, ms) {
+    if (!(this instanceof FrozenDate)) return new NativeDate(fixedMs).toString();
+    if (arguments.length === 0) return new NativeDate(fixedMs);
+    if (arguments.length === 1) return new NativeDate(y);
+    return new NativeDate(y, mo, d === undefined ? 1 : d, h || 0, mi || 0, s || 0, ms || 0);
+  }
+  FrozenDate.prototype = NativeDate.prototype;
+  FrozenDate.now = function () { return fixedMs; };
+  FrozenDate.parse = NativeDate.parse;
+  FrozenDate.UTC = NativeDate.UTC;
+  window.Date = FrozenDate;
+  window.__HKDB_FROZEN_MS__ = fixedMs;
+})();
+</script>
