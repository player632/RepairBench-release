+  menuItemCount: (): number => qa('[role="menuitem"]').length,
+  setEmailDialogPresent: (): boolean => q(".set-email-dialog") !== null,
+
+  // ---- appearance selector -------------------------------------------------
+  tabActive: (): string => {
