+  canvasX: (): number => parseTransform(canvasInner()?.style.transform ?? "").x,
+  canvasY: (): number => parseTransform(canvasInner()?.style.transform ?? "").y,
+  canvasScale: (): number => parseTransform(canvasInner()?.style.transform ?? "").scale,
+  soundIcon: (): string => {
