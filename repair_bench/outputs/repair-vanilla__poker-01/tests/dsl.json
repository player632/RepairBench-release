  {
   "id": "P26",
   "kind": "interaction",
   "partition": "P2P",
   "source_ac_id": "decoy-guard-bots-fill-empty-seats",
   "setup": [
    {
     "action": "goto",
     "target": "/index.html"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 800
    },
    {
     "action": "js_eval",
     "expr": "(async function(){var h=document.querySelectorAll('.seat')[0].querySelector('h3');h.textContent='RB Player';document.getElementById('start-button').click();function census(){var ss=document.querySelectorAll('.seat');var vis=0,hum=0,bots=[];for(var i=0;i<ss.length;i++){var s=ss[i];if(s.classList.contains('hidden')){continue;}vis++;if(s.classList.contains('bot')){bots.push(s.querySelector('h3').textContent.trim());}else{hum++;}}bots.sort();return JSON.stringify({seats:String(vis),bots:String(bots.length),names:bots.join('|'),human:String(hum)})}function settled(c){return JSON.parse(c).names.split('|').every(function(n){return /^Bot [0-9]+$/.test(n)})}var t0=Date.now();var c=census();while(!settled(c)&&Date.now()-t0<120000){await new Promise(function(r){setTimeout(r,100)});c=census()}Object.defineProperty(window,'__rbPokerP26',{value:String(c),writable:false,configurable:false});return true})()"
    }
   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "window.__rbPokerP26",
     "expected": "{\"seats\":\"6\",\"bots\":\"5\",\"names\":\"Bot 1|Bot 2|Bot 3|Bot 4|Bot 5\",\"human\":\"1\"}",
     "expected_intent": "只给 0 号座位填了名字就点 Start：其余 5 个空名字段必须自动变成机器人（名字由 js/app.js createPlayers 的 botIndex 现生成），座位数仍是 6、人类仍是 1——这是提示条明写的正常行为，不是缺陷"
    }
   ]
  },
