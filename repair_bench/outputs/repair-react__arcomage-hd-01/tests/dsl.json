     "expr": "(async function(){var t0=Date.now();var ok=false;while(Date.now()-t0<20000){try{var s=window.__rb.state();if(s&&s.game&&s.game.playersTurn===true&&s.game.locked&&!s.game.locked.some(function(l){return l===true})){ok=true;break}}catch(e){}await new Promise(function(r){setTimeout(r,250)})}if(!ok)return -1;var st=window.__rb.state();var lim=st.settings.cardsInHand;var cs=[].slice.call(document.querySelectorAll('[data-rb-owner=\"player\"][data-rb-kind=\"front\"]'));var best=null;for(var i=0;i<cs.length;i++){var p=Number(cs[i].getAttribute('data-rb-position'));if(!isFinite(p)||p<0||p>=lim)continue;if(best===null||p<best)best=p}if(best===null)return -3;for(var j=0;j<cs.length;j++){if(Number(cs[j].getAttribute('data-rb-position'))===best){cs[j].click();return best}}return -4})()"
