diff --git a/rb-offline/inert.css b/rb-offline/inert.css
new file mode 100644
--- /dev/null
+++ b/rb-offline/inert.css
@@ -0,0 +1,4 @@
+/* rb-offline/inert.css - offline stand-in installed by environment/adaptation.patch.
+   The documents used to pull a remote webfont stylesheet from here. With no network the request
+   would hang the render, so it is repointed at this inert local file. Fonts fall back to the
+   document's own generic families. HARNESS, not application code, not on the tested surface. */
diff --git a/rb-offline/inert.js b/rb-offline/inert.js
new file mode 100644
--- /dev/null
+++ b/rb-offline/inert.js
@@ -0,0 +1,7 @@
+// rb-offline/inert.js - offline stand-in installed by environment/adaptation.patch.
+// The document used to load a third-party analytics tag manager from a remote host here. The task
+// runs with no network at all, so this file is the inert local replacement: it defines the same
+// two globals the document's own inline snippet expects (window.dataLayer and window.gtag) and
+// does nothing with them. It is HARNESS, not application code, and it is not on the tested surface.
+window.dataLayer = window.dataLayer || [];
+window.gtag = function gtag() { window.dataLayer.push(arguments); };
