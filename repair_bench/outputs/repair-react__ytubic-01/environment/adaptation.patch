-      const prose = [
-        entry.summary,
-        entry.note ?? "",
-        entry.alert ?? "",
-        ...entry.changes.flatMap((c) => [c.title, c.text]),
-      ].join(" ");
-      expect(prose, `${entry.version} contains a dash character`).not.toMatch(
-        /[–—]/,
-      );
-    }
-  });
