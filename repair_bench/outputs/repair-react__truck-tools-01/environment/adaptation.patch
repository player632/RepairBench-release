+	truckTransmission: "rb_trs_s12",
+	truckKm: "150000",
+	truckFuel: "1",
+	trailerChassisMass: "3000",
+	trailerBodyMass: "1000",
+	cargoMass: "20000",
+	licensePlateTruck: "RB-TRUCK",
+	licensePlateTruckBg: "#bf2222",
