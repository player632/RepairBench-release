diff --git a/.env.production b/.env.production
index a8c4045c1046a5538642eab589543dc8db2f03b9..ba35876 100644
--- a/.env.production
+++ b/.env.production
@@ -4,7 +4,19 @@
 VITE_APP_TITLE = H5低代码
 
 # 网站前缀
-VITE_BASE_URL = /vite-vue3-lowcode/
+# Repair-Bench offline adaptation (A). The upstream value was '/vite-vue3-lowcode/'
+# (the author's GitHub Pages project prefix). vite.config.ts feeds it straight into
+# `base`, so every emitted asset URL in dist/index.html carried that prefix - measured:
+# href="/vite-vue3-lowcode/favicon.ico", src="/vite-vue3-lowcode/assets/main.835af08e.js",
+# 3 modulepreload links, 4 stylesheets and both nomodule legacy entries. The verifier
+# serves dist/ at the origin root (evaluation/serve_static.mjs only accepts
+# --dir/--port/[--no-spa]; it has no base/prefix option), so all of them 404 and the
+# app never boots. Root-relative base is the neutral value: the build was re-run with
+# it (rc=0, wall 119 s) and GET / plus GET /assets/main.e14101f7.js both returned 200.
+# BASE_URL is consumed by src/visual-editor/utils/index.ts:14 and therefore by
+# header/preview.vue:30, header/index.vue:48/55/61 and
+# src/packages/base-widgets/tabbar/index.tsx:90 - all three resolve correctly at '/'.
+VITE_BASE_URL = /
 
 # 是否删除console
 VITE_DROP_CONSOLE = true
