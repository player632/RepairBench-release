diff --git a/public/rb/embed.html b/public/rb/embed.html
new file mode 100644
index 0000000000000000000000000000000000000000..3d0d8b2ff94c117e947cc24a1cec4bcfde9824a4
--- /dev/null
+++ b/public/rb/embed.html
@@ -0,0 +1,25 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>repair-bench offline video stub</title>
+<style>html,body{margin:0;height:100%;background:#101014;color:#efece3;font:14px/1.5 ui-monospace,monospace}
+.wrap{display:flex;height:100%;align-items:center;justify-content:center;flex-direction:column;gap:8px}</style>
+</head>
+<body data-rb-stub="embed">
+<div class="wrap" id="rb-embed" data-rb-key="" data-rb-rel="" data-rb-autoplay="" data-rb-mute="">
+  <div id="rb-embed-label">offline video stub</div>
+  <div id="rb-embed-key"></div>
+</div>
+<script>
+(function () {
+  var p = new URLSearchParams(window.location.search);
+  var box = document.getElementById('rb-embed');
+  var names = ['key', 'rel', 'autoplay', 'mute'];
+  for (var i = 0; i < names.length; i += 1) box.setAttribute('data-rb-' + names[i], p.get(names[i]) || '');
+  document.getElementById('rb-embed-key').textContent = p.get('key') || '(no key)';
+  document.title = 'stub:' + (p.get('key') || 'none');
+})();
+</script>
+</body>
+</html>
diff --git a/public/rb/external.html b/public/rb/external.html
new file mode 100644
index 0000000000000000000000000000000000000000..6b5054771e01c13fc6e34255a97587c5293aed53
--- /dev/null
+++ b/public/rb/external.html
@@ -0,0 +1,25 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>repair-bench offline outbound-link stub</title>
+<style>html,body{margin:0;padding:32px;background:#15161a;color:#efece3;font:14px/1.6 ui-monospace,monospace}
+code{word-break:break-all}</style>
+</head>
+<body data-rb-stub="external">
+<h1>Outbound link suppressed</h1>
+<p id="rb-external-msg">This build is offline. The link you followed pointed at:</p>
+<p><code id="rb-external-to"></code></p>
+<p>No navigation leaves this origin.</p>
+<script>
+(function () {
+  var to = new URLSearchParams(window.location.search).get('to') || '';
+  var box = document.getElementById('rb-external-to');
+  box.textContent = to;
+  document.body.setAttribute('data-rb-to', to);
+  document.body.setAttribute('data-rb-to-host', (function () { try { return new URL(to).host; } catch (e) { return ''; } })());
+  document.title = 'stub:' + (function () { try { return new URL(to).host; } catch (e) { return 'none'; } })();
+})();
+</script>
+</body>
+</html>
