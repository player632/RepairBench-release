     "expr": "(()=>{const el=document.querySelector('[data-i=\"40\"]');const r=el.getBoundingClientRect();const cx=r.left+r.width/2,cy=r.top+r.height/2;const o={bubbles:true,cancelable:true,clientX:cx,clientY:cy,pointerId:1,pointerType:'mouse',isPrimary:true,button:0,buttons:1};el.dispatchEvent(new PointerEvent('pointerdown',o));el.dispatchEvent(new MouseEvent('mousedown',{bubbles:true,cancelable:true,clientX:cx,clientY:cy,button:0,buttons:1}));})()"
