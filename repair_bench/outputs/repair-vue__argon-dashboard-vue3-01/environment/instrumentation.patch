 <body>
+  <script>
+    /* RB instrumentation probe (instrumentation.patch). Read-only, dependency-free, offline.
+       Installed as a CLASSIC inline script ahead of the deferred module entry so it can
+       observe boot errors and the resource timeline from the first moment. Exposes a frozen
+       window.__rb whose readers all return a SCALAR (string/number/boolean) because
+       evaluation/dsl_runner.mjs compares js_eval results with a loose ==, so an object or
+       array expectation could never pass. It writes nothing, patches nothing, and creates
+       exactly one global: window.__rb itself. */
+    (function () {
+      var ERR = '__ERR__';
+      var errors = [];
+      function safe(fn) {
+        try { var v = fn(); return (v === undefined || v === null) ? '' : v; }
+        catch (e) { return ERR; }
+      }
+      window.addEventListener('error', function (ev) {
+        try { errors.push(String(ev && ev.message ? ev.message : 'error')); }
+        catch (e) { errors.push('error'); }
+      });
+      window.addEventListener('unhandledrejection', function (ev) {
+        try { errors.push('unhandledrejection:' + String(ev && ev.reason ? ev.reason : '')); }
+        catch (e) { errors.push('unhandledrejection'); }
+      });
+      function externalResources() {
+        var out = 0;
+        var list = performance.getEntriesByType('resource') || [];
+        for (var i = 0; i < list.length; i++) {
+          var name = String(list[i].name || '');
+          if (!name) continue;
+          if (/^(data|blob|about|filesystem):/i.test(name)) continue;
+          var origin = '';
+          try { origin = new URL(name, location.href).origin; } catch (e) { origin = ERR; }
+          if (origin !== location.origin) out++;
+        }
+        return out;
+      }
+      function resourceTotal() {
+        var list = performance.getEntriesByType('resource') || [];
+        return list.length;
+      }
+      function rbGlobals() {
+        var keep = Object.getOwnPropertyNames(window).filter(function (k) {
+          return /^__rb/.test(k) && k !== '__rb';
+        });
+        keep.sort(); return keep.join('|');
+      }
+      function storageKeys(which) {
+        try { return Object.keys(window[which]).sort().join(String.fromCharCode(124)); }
+        catch (e) { return ERR; }
+      }
+      function ready() {
+        var app = document.getElementById('app');
+        return !!(app && app.children.length > 0 && document.querySelector('[data-testid]') !== null);
+      }
+      function domCount(selector) {
+        try { return document.querySelectorAll(selector).length; } catch (e) { return -1; }
+      }
+      function domText(selector) {
+        try {
+          var e = document.querySelector(selector);
+          if (!e) return '';
+          var t = (e.innerText === undefined || e.innerText === null) ? e.textContent : e.innerText;
+          return String(t).replace(/\s+/g, ' ').replace(/^\s+|\s+$/g, '');
+        } catch (e2) { return ERR; }
+      }
+      window.__rb = Object.freeze({
+        boot: Object.freeze({ ready: function () { return safe(ready); } }),
+        errors: Object.freeze({
+          count: function () { return safe(function () { return errors.length; }); },
+          messages: function () { return safe(function () { return errors.join('|'); }); }
+        }),
+        net: Object.freeze({
+          external: function () { return safe(externalResources); },
+          total: function () { return safe(resourceTotal); }
+        }),
+        residue: Object.freeze({
+          globals: function () { return safe(rbGlobals); },
+          localStorageKeys: function () { return safe(function () { return storageKeys('localStorage'); }); },
+          sessionStorageKeys: function () { return safe(function () { return storageKeys('sessionStorage'); }); },
+          pathname: function () { return safe(function () { return location.pathname; }); }
+        }),
+        dom: Object.freeze({
+          count: function (s) { return safe(function () { return domCount(s); }); },
+          text: function (s) { return safe(function () { return domText(s); }); }
+        })
+      });
+    })();
+  </script>
