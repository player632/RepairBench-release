   components: { GoogleMap, Marker },
diff --git a/public/rb-assets/fonts.css b/public/rb-assets/fonts.css
new file mode 100644
--- /dev/null
+++ b/public/rb-assets/fonts.css
@@ -0,0 +1,26 @@
+/* RB-OFFLINE fixture created by adaptation.patch.
+ * Same-origin replacement for the Google Fonts CSS2 stylesheet that index.html used to
+ * load from fonts.googleapis.com for the 'Open Sans' family the app asks for
+ * (src/index.css @layer base { * { font-family: "Open Sans", sans-serif } } and
+ * tailwind.config.js theme.fontFamily.body).
+ *
+ * Every src is local() ONLY, so this file can never cause a network request. Where no
+ * local Open Sans is installed the face simply fails to resolve and the browser falls back
+ * to the generic sans-serif stack - byte-for-byte the same outcome as upstream when the
+ * CDN is unreachable under allow_internet=false. No measured behaviour of the seed depends
+ * on the actual glyph outlines.
+ */
+@font-face {
+  font-family: 'Open Sans';
+  font-style: normal;
+  font-weight: 300 800;
+  font-display: swap;
+  src: local('Open Sans Light'), local('OpenSans-Light'), local('Open Sans'), local('OpenSans');
+}
+@font-face {
+  font-family: 'Open Sans';
+  font-style: italic;
+  font-weight: 300 800;
+  font-display: swap;
+  src: local('Open Sans Italic'), local('OpenSans-Italic'), local('Open Sans'), local('OpenSans');
+}
