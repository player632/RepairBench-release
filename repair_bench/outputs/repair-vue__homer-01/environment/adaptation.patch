diff --git a/public/assets/config.yml b/public/assets/config.yml
new file mode 100644
index 000000000..f4ac6751e
--- /dev/null
+++ b/public/assets/config.yml
@@ -0,0 +1,153 @@
+---
+# Homer dashboard configuration (offline fixture).
+#
+# This file is the seed's own documented user-configuration mechanism: the app
+# fetches /assets/config.yml at boot (src/App.vue getConfig()) and the upstream
+# tree ships public/assets/config.yml.dist plus public/assets/config-demo.yml.dist
+# as the blueprints a user is expected to copy into place. This copy follows those
+# blueprints. Every smart card points its `endpoint` at the seed's own tracked
+# dummy-data/ fixtures - exactly what public/assets/config-demo.yml.dist already
+# does for octoprint/pihole/proxmox/peanut/openweather - and those fixtures are
+# copied verbatim into public/dummy-data/ so that they survive `vite build`
+# (the seed's dummy-data-json-handler is a dev-server middleware only).
+# No process is started, no request leaves the origin, no application code is
+# changed by this file: it is input data for the dashboard.
+
+title: "Rack Four"
+subtitle: "Homelab dashboard"
+logo: "logo.png"
+
+header: true
+# `footer` is deliberately NOT set here, so the value comes from
+# src/assets/defaults.yml through the documented defaults + user-config merge.
+
+theme: default
+
+columns: "3"
+
+defaults:
+  layout: columns
+  colorTheme: light
+  iconWidth: auto
+
+connectivityCheck: true
+
+message:
+  style: "is-dark"
+  title: "Maintenance window"
+  icon: "fa fa-triangle-exclamation"
+  content: "Rack four is running on the backup PDU this week."
+  url: "/dummy-data/nextcloud/status.php"
+  mapping:
+    title: "productname"
+    content: "versionstring"
+
+links:
+  - name: "Cold storage"
+    icon: "fas fa-snowflake"
+    url: "#additional-page"
+  - name: "Wiki"
+    icon: "fas fa-book"
+    url: "https://www.wikipedia.org/"
+    target: "_blank"
+
+# NOTE: no global `updateIntervalMs` here, so the centralised scheduler only
+# picks up the cards that ask for a refresh interval themselves.
+services:
+  - name: "Infrastructure"
+    icon: "fas fa-server"
+    items:
+      - name: "AdGuard DNS"
+        type: "AdGuardHome"
+        icon: "fas fa-shield-halved"
+        endpoint: "/dummy-data/adguardhome"
+        url: ""
+        tag: "dns"
+      - name: "Node metrics"
+        type: "Glances"
+        icon: "fas fa-microchip"
+        endpoint: "/dummy-data/glances"
+        url: ""
+        stats:
+          - "load"
+          - "cpu"
+          - "mem"
+          - "swap"
+        # the deprecated per-service key, still documented in AGENTS.md
+        updateInterval: 2000
+      - name: "Storage"
+        type: "Nextcloud"
+        icon: "fas fa-hard-drive"
+        endpoint: "/dummy-data/nextcloud"
+        url: ""
+  - name: "Media"
+    icon: "fas fa-film"
+    items:
+      - name: "Sonarr"
+        type: "Sonarr"
+        icon: "fas fa-tv"
+        endpoint: "/dummy-data/sonarr"
+        url: ""
+        apikey: "rb-fixture-key"
+        tag: "arr"
+      - name: "qBittorrent"
+        type: "qBittorrent"
+        icon: "fas fa-download"
+        endpoint: "/dummy-data/qbittorrent"
+        url: ""
+      - name: "Uptime Kuma"
+        type: "UptimeKuma"
+        icon: "fas fa-heart-pulse"
+        endpoint: "/dummy-data/uptimekuma"
+        url: ""
+        slug: "default"
+  - name: "Monitoring"
+    icon: "fas fa-chart-line"
+    items:
+      - name: "Requests"
+        type: "Seerr"
+        icon: "fas fa-clapperboard"
+        endpoint: "/dummy-data/seerr"
+        url: ""
+        apikey: "rb-seerr-key"
+        tag: "media"
+      - name: "Edge ping"
+        type: "Ping"
+        icon: "fas fa-satellite-dish"
+        endpoint: "/dummy-data/traefik/api/version"
+        url: ""
+        updateIntervalMs: 2000
+      - name: "Core ping"
+        type: "Ping"
+        icon: "fas fa-network-wired"
+        endpoint: "/dummy-data/vaultwarden/api/version"
+        url: ""
+        updateIntervalMs: 2000
+  - name: "Tools"
+    icon: "fas fa-toolbox"
+    items:
+      - name: "Theme"
+        type: "ThemeChooser"
+        icon: "fas fa-palette"
+        subtitle: "Switch the dashboard theme"
+        url: ""
+      - name: "Copy gateway"
+        type: "CopyToClipboard"
+        icon: "fas fa-copy"
+        subtitle: "10.0.0.1"
+        clipboard: "10.0.0.1"
+        url: ""
+      - name: "Runbook"
+        icon: "fas fa-book-open"
+        subtitle: "What to do when a rack alarms"
+        tag: "docs"
+        url: ""
+      - name: "Icon gallery"
+        icon: "fas fa-icons"
+        tag: "docs"
+        url: ""
+        quick:
+          - name: "selfh.st"
+            url: "#selfhst"
+            icon: "fa-solid fa-arrow-up-right-from-square"
+            target: "_blank"
