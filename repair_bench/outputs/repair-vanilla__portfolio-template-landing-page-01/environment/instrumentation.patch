+    <!-- offline verification bridge (instrumentation IN-1): a fresh-read probe surface for the
+         checkpoints in tests/dsl.json. EVERY member is an accessor over the live document, so a
+         consumer must re-read window.__CRIMSON__ on each access and can never observe a stale
+         snapshot; nothing here is cached, nothing here writes to the document and nothing here
+         changes behaviour. It is inlined ahead of the vendor scripts so the accessors exist
+         before the document-ready controller runs, while everything they read stays live. -->
+    <script>
+    (function () {
+      "use strict";
+      var all = function (s) { try { return Array.prototype.slice.call(document.querySelectorAll(s)); } catch (e) { return []; } };
+      var one = function (s) { try { return document.querySelector(s); } catch (e) { return null; } };
+      var txt = function (n) { return n ? String(n.textContent || "").replace(/\s+/g, " ").trim() : null; };
+      var has = function (n, c) { return !!n && !!n.classList && n.classList.contains(c); };
+      var inline = function (n, p) { return n && n.style ? String(n.style[p] || "") : ""; };
+      var join = function (xs) { return xs.join("|"); };
+      window.__CRIMSON__ = {
+        get bootDone() { return !!window.jQuery && all(".cavani_tm_section").length === 6 && !!one(".cavani_tm_modalbox"); },
+        get documentTitle() { return document.title; },
+        get preloaderPresent() { return !!one("#preloader"); },
+        get sectionCount() { return all(".cavani_tm_section").length; },
+        get sectionIds() { return join(all(".cavani_tm_section").map(function (n) { return n.id; })); },
+        get activeSectionId() { var n = one(".cavani_tm_section.active"); return n ? n.id : null; },
+        get shownSectionCount() { return all(".cavani_tm_section:not(.hidden)").length; },
+        get shownSectionIds() { return join(all(".cavani_tm_section:not(.hidden)").map(function (n) { return n.id; })); },
+        get headerNavCount() { return all(".cavani_tm_header .menu .transition_link a").length; },
+        get headerNavHrefs() { return join(all(".cavani_tm_header .menu .transition_link a").map(function (n) { return n.getAttribute("href"); })); },
+        get headerNavLabels() { return join(all(".cavani_tm_header .menu .transition_link a").map(txt)); },
+        get headerActiveLiCount() { return all(".cavani_tm_header .menu .transition_link li.active").length; },
+        get headerActiveLiLabel() { return txt(one(".cavani_tm_header .menu .transition_link li.active")); },
+        get homePanelAnchorHrefs() { return join(all("#home .transition_link a").map(function (n) { return n.getAttribute("href"); })); },
+        get menuTriggerActive() { return has(one(".cavani_tm_topbar .trigger .hamburger"), "is-active"); },
+        get mobileMenuOpened() { return has(one(".cavani_tm_mobile_menu"), "opened"); },
+        get barCount() { return all(".progress_inner").length; },
+        get barDataValues() { return join(all(".progress_inner").map(function (n) { return n.getAttribute("data-value"); })); },
+        get barLabels() { return join(all(".progress_inner .label").map(txt)); },
+        get barFillWidths() { return join(all(".progress_inner").map(function (n) { return inline(n.querySelector(".bar_in"), "width"); })); },
+        get barTrackOpenCount() { return all(".progress_inner .bar.open").length; },
+        get ringCount() { return all(".circular_progress_bar .myCircle").length; },
+        get ringDataValues() { return join(all(".circular_progress_bar .myCircle").map(function (n) { return n.getAttribute("data-value"); })); },
+        get ringTitles() { return join(all(".circular_progress_bar .title span").map(txt)); },
+        get ringNumbers() { return join(all(".circular_progress_bar .myCircle .number").map(txt)); },
+        get ringCanvasCount() { return all(".circular_progress_bar .myCircle canvas").length; },
+        get headlineWordCount() { return all(".cd-words-wrapper b").length; },
+        get headlineWords() { return join(all(".cd-words-wrapper b").map(txt)); },
+        get headlineVisibleCount() { return all(".cd-words-wrapper b.is-visible").length; },
+        get headlineVisibleWord() { return txt(one(".cd-words-wrapper b.is-visible")); },
+        get homeName() { return txt(one(".cavani_tm_home .name")); },
+        get homeStaticRole() { return txt(one(".cavani_tm_home .blc")); },
+        get glitchStageChildCount() { var n = one(".glitch_wrap"); return n ? n.children.length : -1; },
+        get glitchLayerCounts() { return join(["back", "front-1", "front-2", "front-3"].map(function (c) { return all(".glitch_wrap ." + c).length; })); },
+        get filterLinkCount() { return all(".portfolio_filter a").length; },
+        get filterSelectors() { return join(all(".portfolio_filter a").map(function (n) { return n.getAttribute("data-filter"); })); },
+        get filterCurrentCount() { return all(".portfolio_filter a.current").length; },
+        get filterCurrentLabel() { return txt(one(".portfolio_filter a.current")); },
+        get portfolioItemCount() { return all(".portfolio_list ul > li").length; },
+        get portfolioPopupCount() { return all(".portfolio_popup").length; },
+        get newsItemCount() { return all(".news_list > ul > li").length; },
+        get newsItemImages() { return join(all(".news_list > ul > li").map(function (n) { return n.getAttribute("data-img") || ""; })); },
+        get movingBoxPresent() { return !!one(".cavani_fn_moving_box"); },
+        get movingBoxOpened() { return has(one(".cavani_fn_moving_box"), "opened"); },
+        get movingBoxImage() { return inline(one(".cavani_fn_moving_box"), "backgroundImage"); },
+        get modalPresent() { return !!one(".cavani_tm_modalbox"); },
+        get modalOpened() { return has(one(".cavani_tm_modalbox"), "opened"); },
+        get modalClosePresent() { return !!one(".cavani_tm_modalbox .close"); },
+        get modalDescriptionPresent() { return !!one(".cavani_tm_modalbox .description_wrap"); },
+        get modalDescriptionLength() { var n = one(".cavani_tm_modalbox .description_wrap"); return n ? String(n.innerHTML || "").trim().length : -1; },
+        get contactFieldIds() { return join(["#name", "#email", "#message", "#send_message"].map(function (s) { return one(s) ? "1" : "0"; })); },
+        get contactSuccessMessage() { var n = one(".contact_form .returnmessage"); return n ? String(n.getAttribute("data-success") || "") : null; },
+        get emptyNoticeText() { return txt(one(".empty_notice span")); },
+        get servicePanelListCount() { return all("#service .service_list").length; },
+        get cursorElementCount() { return all(".mouse-cursor").length; },
+        get cursorTransforms() { return join([one(".cursor-inner"), one(".cursor-outer")].map(function (n) { return inline(n, "transform"); })); },
+        get indicatorInlineLeft() { return inline(one(".cavani_tm_header .menu .ccc"), "left"); },
+        get indicatorInlineWidth() { var v = parseFloat(inline(one(".cavani_tm_header .menu .ccc"), "width")); return isNaN(v) ? -1 : v; },
+        get replacedSvgCount() { return all("svg.replaced-svg").length; },
+        get socialPlaceholderAnchorCount() { return all('a[href="#"] svg.replaced-svg').length; },
+        get storageKeyCount() { var n = 0; try { n += window.localStorage.length; } catch (e) {} try { n += window.sessionStorage.length; } catch (e) {} return n; },
+        get urlParts() { return [location.pathname, location.search, location.hash].join("~"); },
+        get residueGlobals() { return Object.keys(window).filter(function (k) { return /^__rb|_fix_|_patch_|_hack_|^__solution/i.test(k); }).length; }
+      };
+    })();
+    </script>
