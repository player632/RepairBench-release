+// INSTRUMENTATION (repair-bench, environment/instrumentation.patch) - src/rb-probe.ts
+//
+// A READ-ONLY observation bridge for the offline verifier, published on window.__BH__.
+//
+// The seed ships no test facility of its own: no test id, no data-attribute contract, no
+// exported state accessor that a headless browser could read. Nothing was removed to make room
+// for this file. It observes the document and the app's own Svelte stores through their public
+// subscriptions; it never writes to a store, never patches a component and never changes a
+// rendered value. The only thing it mutates is its own error counter.
+//
+// Every reader returns a SCALAR (number | string | boolean). Collections are returned as a
+// joined string or a length, because the delivered DSL asserts with js_eval and that compares
+// scalars. Readers are deliberately written against the DOM the seed already produces
+// (data-preference, data-collapsible-container, data-state, data-before, data-after,
+// aria-current, inert) plus the data-rb-* structural hooks this patch adds, so a reading stays
+// meaningful even if the agent's fix rewrites the components around them.
+//
+// The drivers at the bottom dispatch the events the seed ALREADY listens for - a cross-window
+// StorageEvent (src/utils/localStorageWritable.ts:15), the app's own
+// blockhead_addAccountConnection window event (src/routes/+layout.svelte:267), a real
+// requestSubmit() on the contact form, and ordinary input/change events on a bound input - so
+// an interaction exercises the seed's own event contract instead of poking private state.
+
+import { get } from 'svelte/store'
+
+import { preferences, preferencesConfig } from '$/state/preferences'
+import { colorTheme } from '$/state/colorTheme'
+import { prefersReducedMotion } from '$/state/prefersReducedMotion'
+
+const W = globalThis as any
+
+// ---------------------------------------------------------------- error trap
+let errorCount = 0
+const errorTexts: string[] = []
+
+const trap = () => {
+	const note = (text: string) => {
+		errorCount++
+		if (errorTexts.length < 40) errorTexts.push(String(text).slice(0, 200))
+	}
+
+	W.addEventListener?.('error', (e: any) => note(e?.message || e))
+	W.addEventListener?.('unhandledrejection', (e: any) => note(e?.reason?.message || e?.reason || e))
+}
+
+// ---------------------------------------------------------------- dom helpers
+const q = (sel: string): Element | null => { try { return document.querySelector(sel) } catch (e) { return null } }
+const qa = (sel: string): Element[] => { try { return Array.from(document.querySelectorAll(sel)) } catch (e) { return [] } }
+const norm = (s: any) => String(s ?? '').replace(/\s+/g, ' ').trim()
+const attr = (sel: string, name: string): string | null => { const el = q(sel); return el ? el.getAttribute(name) : null }
+const text = (sel: string) => { const el = q(sel); return el ? norm(el.textContent) : '' }
+const count = (sel: string) => qa(sel).length
+const computed = (sel: string, prop: string) => { const el = q(sel) as HTMLElement | null; return el ? norm(W.getComputedStyle(el).getPropertyValue(prop)) : '' }
+const boolAttr = (sel: string, name: string) => { const el = q(sel); return el ? el.hasAttribute(name) : false }
+
+// ---------------------------------------------------------------- zero-network face
+// House definition (the delivered graphml-viewer package uses the same one): a reference tag is
+// an element that makes the browser FETCH something, carrying an absolute http(s) or a
+// protocol-relative URL. data: / blob: URIs are inline payloads, not requests, and are excluded
+// by construction because they do not start with http or //.
+// MEASURED CORRECTION (leg BH2 run 4 -> run 5). The origin-blind selector form of this census -
+// counting every link[href^="http"] - is a FALSE POSITIVE on a SvelteKit client-rendered face: the
+// kit's own router injects modulepreload and stylesheet links whose href is an ABSOLUTE SAME-ORIGIN
+// url, so 25 tags matched href^="http" and 26 stylesheets matched, while the browser made 129
+// requests, every single one to 127.0.0.1:12326, 0 failed, 0 websockets, and the Performance API
+// reported 0 cross-origin resources. "Zero runtime network" means nothing leaves this origin, so the
+// census resolves every candidate URL against the document origin and counts only what would leave
+// it. The origin-blind counts stay published beside it under names that say what they are, so both
+// readings are on the record and neither can be mistaken for the other.
+const ABS_REF_SEL = 'link[href^="http"], script[src^="http"], link[href^="//"], script[src^="//"]'
+const ABS_RES_SEL = 'link[href], script[src], img[src], iframe[src], source[src], video[src], audio[src], embed[src], object[data]'
+const isCrossOrigin = (raw: string): boolean => {
+	const url = String(raw || '')
+	if (!/^(https?:)?\/\//i.test(url)) return false
+	try { return new W.URL(url, W.location.href).origin !== W.location.origin } catch (e) { return true }
+}
+function externalRefTagCount(): number {
+	return qa(ABS_REF_SEL).filter((el) => isCrossOrigin(String(el.getAttribute('href') || el.getAttribute('src') || ''))).length
+}
+function externalRefTags(): string {
+	const hits: string[] = []
+	for (const el of qa(ABS_REF_SEL)) {
+		const url = String(el.getAttribute('href') || el.getAttribute('src') || '')
+		if (isCrossOrigin(url)) hits.push(el.tagName.toLowerCase() + ':' + url.slice(0, 120))
+	}
+	return hits.sort().join('|')
+}
+// Wider sweep: EVERY element capable of pulling a subresource, cross-origin only.
+function externalResourceTagCount(): number {
+	return qa(ABS_RES_SEL).filter((el) => isCrossOrigin(String(el.getAttribute('href') || el.getAttribute('src') || el.getAttribute('data') || ''))).length
+}
+function hasGtag(): boolean { try { return typeof W.gtag === 'function' || !!W.google_tag_manager } catch (e) { return false } }
+function hasDataLayer(): boolean { try { return W.dataLayer !== undefined } catch (e) { return false } }
+function remoteStyleSheetCount(): number {
+	let n = 0
+	for (let i = 0; i < document.styleSheets.length; i++) {
+		const href = (document.styleSheets[i] as any).href
+		if (href && isCrossOrigin(String(href))) n++
+	}
+	return n
+}
+// The origin-blind readings, kept on the record. These are NOT asserted as zero: on this face they
+// count the kit's own same-origin absolute URLs (measured 25 / 26 / 26 at boot).
+function absoluteUrlRefTagCount(): number { return qa(ABS_REF_SEL).length }
+function absoluteUrlResourceTagCount(): number {
+	return qa(ABS_RES_SEL).filter((el) => /^(https?:)?\/\//i.test(String(el.getAttribute('href') || el.getAttribute('src') || el.getAttribute('data') || ''))).length
+}
+function absoluteUrlStyleSheetCount(): number {
+	let n = 0
+	for (let i = 0; i < document.styleSheets.length; i++) { const href = (document.styleSheets[i] as any).href; if (href && /^(https?:)?\/\//i.test(String(href))) n++ }
+	return n
+}
+function sameOriginAbsoluteRefTagCount(): number { return absoluteUrlRefTagCount() - externalRefTagCount() }
+function externalPerformanceResourceCount(): number {
+	try {
+		const origin = W.location.origin
+		return W.performance.getEntriesByType('resource')
+			.filter((e: any) => { try { return new W.URL(String(e.name), W.location.href).origin !== origin } catch (err) { return false } })
+			.length
+	} catch (e) { return -1 }
+}
+function performanceResourceCount(): number { try { return W.performance.getEntriesByType('resource').length } catch (e) { return -1 } }
+
