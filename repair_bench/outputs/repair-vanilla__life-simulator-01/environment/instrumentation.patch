+	function command(name, fn) {
+		lastCmd.count++;
+		try {
+			var out = fn();
+			lastCmd.ok = true; lastCmd.error = null;
+			cmdLog.push({ name: name, ok: true });
+			if (cmdLog.length > 40) cmdLog.shift();
+			return out === undefined ? true : out;
+		} catch (e) {
+			lastCmd.ok = false; lastCmd.error = String((e && e.message) || e).slice(0, 300);
+			cmdLog.push({ name: name, ok: false, error: lastCmd.error });
+			if (cmdLog.length > 40) cmdLog.shift();
+			return null;
+		}
+	}
