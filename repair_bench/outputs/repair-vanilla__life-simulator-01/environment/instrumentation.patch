+			/* --- boot face: did the ten classic scripts all evaluate? --- */
+			boot_completed: bool(gv("typeof annualChanges === 'function' && typeof menu === 'object' && typeof windows === 'object' && typeof Person === 'function' && typeof skillListifier === 'function'")),
+			boot_symbols: safe(function () {
+				var names = ['annualChanges', 'menu', 'windows', 'Person', 'player', 'characters', 'year', 'jobs', 'items', 'assets', 'skillListifier', 'lifeStageDisplayer', 'statsBuffer', 'skillLeveler', 'specificEvents', 'moneyViewer', 'randomCharacter', 'customCharacter', 'displayCustomization'];
+				var missing = [];
+				for (var i = 0; i < names.length; i++) if (gv('typeof ' + names[i]) === 'undefined') missing.push(names[i]);
+				return missing.join(',');
+			}),
+
+			/* --- model: the player --- */
+			has_player: bool(P !== null),
+			player_name: P ? norm(pf('name')) : null,
+			player_surname: P ? norm(pf('surname')) : null,
+			player_full_name: P ? norm(pf('fullName')) : null,
+			player_age: P ? num(pf('age')) : null,
+			player_gender: P ? norm(pf('gender')) : null,
+			player_nationality: P ? norm(pf('nationality')) : null,
+			player_location: P ? norm(pf('location')) : null,
+			player_life_stage: P ? (pf('lifeStage') === undefined ? null : norm(pf('lifeStage'))) : null,
+			player_driver_license: P ? bool(pf('driverLicense')) : null,
+			player_alive: P ? bool(pf('alive')) : null,
+			current_education: P ? (pf('currentEducation') === undefined ? null : norm(pf('currentEducation'))) : null,
+			current_career_studying: P ? bool(pf('currentCareer.studying')) : null,
+			current_career_label: P ? (pf('currentCareer.label') === undefined ? null : norm(pf('currentCareer.label'))) : null,
+			current_career_years_studied: P ? num(pf('currentCareer.yearsStudied')) : null,
+			characters_length: num(gv('characters.length')),
+			year_value: num(gv('year')),
+
+			/* --- model: money --- */
+			money_total: P ? num(pf('money.total')) : null,
+			money_income: P ? num(pf('money.income')) : null,
+			money_expenses: P ? num(pf('money.expenses')) : null,
+			money_balance: P ? num(safe(function () { return p.money.income - p.money.expenses; })) : null,
+
+			/* --- model: job and cv --- */
+			job_is_none: P ? bool(pf("job === 'none'")) : null,
+			job_label: P ? (pf('job.label') === undefined ? null : norm(pf('job.label'))) : null,
+			job_since: P ? num(pf('job.since')) : null,
+			job_salary: P ? num(pf('job.salary')) : null,
+			cv_length: P ? num(pf('cv.length')) : null,
+			cv0_label: P ? (pf('cv[0].label') === undefined ? null : norm(pf('cv[0].label'))) : null,
+			cv0_since: P ? num(pf('cv[0].since')) : null,
+			cv0_until: P ? num(pf('cv[0].until')) : null,
+			cv0_since_equals_job_since: P ? bool(safe(function () { return p.cv.length > 0 && p.job !== 'none' && p.cv[0].since === p.job.since; })) : null,
+			cv0_is_job_object: P ? bool(safe(function () { return p.cv.length > 0 && p.job !== 'none' && p.cv[0] === p.job; })) : null,
+			catalogue_job0_since_defined: bool(safe(function () { return gv('jobs[0]').since !== undefined; })),
+
+			/* --- model: skills and free time --- */
+			skills_music_level: P ? num(pf('skills.music.level')) : null,
+			skills_music_xp: P ? num(pf('skills.music.xp')) : null,
+			skills_music_xp_needed: P ? num(pf('skills.music.xpNeeded')) : null,
+			skills_programming_level: P ? num(pf('skills.programming.level')) : null,
+			skills_programming_xp: P ? num(pf('skills.programming.xp')) : null,
+			freetime_is_reading: P ? bool(pf('freetime.isReading')) : null,
+			freetime_is_parties: P ? bool(pf('freetime.isAttendingParties')) : null,
+			freetime_is_music: P ? bool(pf('freetime.isTakingMusicLessons')) : null,
+			freetime_is_gym: P ? bool(pf('freetime.goesToGym')) : null,
+
+			/* --- model: per-year action quota --- */
+			actions_friendly: P ? num(pf('actions.friendlyActions')) : null,
+			actions_mean: P ? num(pf('actions.meanActions')) : null,
+			actions_romantic: P ? num(pf('actions.romanticActions')) : null,
+			actions_music: P ? num(pf('actions.music')) : null,
+			actions_programming: P ? num(pf('actions.programming')) : null,
+
+			/* --- model: inventory --- */
+			inventory_instruments_count: P ? num(pf('inventory.instruments.length')) : null,
+			inventory_electronics_count: P ? num(pf('inventory.electronics.length')) : null,
