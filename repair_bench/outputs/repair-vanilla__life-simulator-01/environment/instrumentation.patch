+	/** Click the seed's own element. A real HTMLElement.click() runs the seed's own inline onclick
+	 *  attribute and the seed's own addEventListener handlers, bubbling exactly as a user click on
+	 *  that element would (it does NOT perform hit testing - that is deliberate and is why no
+	 *  checkpoint in this task depends on pointer geometry). */
+	function clickEl(e) {
+		if (!e) throw new Error('element not found');
+		e.click();
+		return true;
+	}
+	function pickByText(sel, text, mode) {
+		var want = norm(text);
+		var list = els(sel);
+		for (var i = 0; i < list.length; i++) {
+			var got = norm(list[i].textContent);
+			if (mode === 'contains' ? got.indexOf(want) !== -1 : got === want) return list[i];
+		}
+		throw new Error('no element matching "' + want + '" (' + mode + ') under ' + sel + ' of ' + list.length);
+	}
+
+	/* ------------------------------------------------------------------ snapshot */
+	function snapshot() {
+		var p = gv('player');
+		var P = (p && typeof p === 'object') ? p : null;
+		function pf(expr) { return P ? gv('player.' + expr) : null; }
+		var s = {
+			ready: true,
+			sentinel: SENTINEL,
