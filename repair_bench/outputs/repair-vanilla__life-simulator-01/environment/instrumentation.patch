+/**
+ * RepairBench instrumentation probe - read-only measurement surface for the life-simulator seed
+ * (robert1811/life-simulator, "Quicklife", a vanilla-JS classic-script life simulator; ZERO-BUILD
+ * static tree, no package.json, no bundler, no transpiler, no framework).
+ *
+ * Added by environment/instrumentation.patch together with ONE `<script src="js/rb-probe.js">`
+ * line in index.html, placed immediately after the adaptation face's js/rb/seed.js and BEFORE the
+ * first application script js/items.js (index.html:103 in the pristine tree). Nothing in this file
+ * reads an application global at evaluation time - every model read happens inside a function, at
+ * call time, through an indirect eval - so loading first is safe and buys one thing that loading
+ * last could not: the window error hooks below are installed BEFORE the ten application scripts
+ * run, so a repair that breaks boot is counted instead of silently missed.
+ *
+ * It touches NO application logic and contains NO copy of any logic under test:
+ *   - it never reimplements annualChanges (js/interface.js:108), studyingProcess, statsBuffer,
+ *     statsChanges, statsLimit, skillLeveler, specificEvents, lifeStageDisplayer, skillListifier,
+ *     moneyFormat, moneyViewer, itemListifier, confirmSell, buy, useItem, apply, leave,
+ *     handleSwitch, chooseCareer, spendTime, jobAssigner or the Person constructor;
+ *   - every model value is read back from the seed's OWN objects (player, characters, year, jobs,
+ *     items, assets, universityCareers, worldEventsMethodArr) and every DOM value from the seed's
+ *     OWN elements, by id or by the data-* attributes the seed itself writes;
+ *   - every transition is produced by the seed's OWN code: a command either calls one of the
+ *     seed's own top-level functions or dispatches a real HTMLElement.click() on one of the seed's
+ *     own elements, which fires the seed's own inline onclick attribute or the seed's own
+ *     addEventListener handler. No rule is evaluated a second time and no state is written
+ *     directly.
+ *   - the only computation done here is AGGREGATION, NORMALISATION and SERIALISATION of values the
+ *     seed already computed (trimming and collapsing whitespace in a text node, counting matching
+ *     elements, joining a key list into a comparable string, freezing one scalar so a later read
+ *     can be compared against it).
+ *
+ * TWO GLOBALS ARE PUBLISHED, and they are the only two this file adds:
+ *   window.__QL__()      a snapshot object RECOMPUTED ON EVERY CALL. Every field is safe-wrapped
+ *                        and yields the sentinel "__rb_probe_error__" instead of throwing, so a
+ *                        half-booted or broken tree surfaces as a FAILED ASSERTION (behaviour
+ *                        evidence) and never as a page crash or a runner setup_failure.
+ *   window.__QL_CMD__    the driver commands listed at the bottom of this file. Each one is
+ *                        wrapped the same way: it records ok/error in last_cmd and returns null
+ *                        instead of throwing.
+ * Parameterised pure reads hang off the snapshot function itself (window.__QL__.contains(sel, s),
+ * .text_of(sel), .count_of(sel), .inline_style(sel, prop), .computed_style(sel, prop),
+ * .attr_of(sel, name), .inventory_index_at(type, i), .skill_row(label), .mark_value(key)) so an
+ * assertion can address one element of a repeated group without this file having to enumerate the
+ * group.
+ *
+ * The probe holds NO expectation, NO timer of its own and NO busy-wait. Two deliberate choices are
+ * recorded because both are load-bearing for the assertion disciplines:
+ *   1. every assertion is a PURE READ. All side effects (creating a character, clicking "Age",
+ *      opening a menu, buying, selling, hiring, toggling a free-time switch) live in setup
+ *      commands, because dsl_runner.mjs polls assertions until the per-checkpoint deadline and an
+ *      assertion with a side effect can flip itself false-green on the second poll.
+ *   2. the ONE two-phase reading (money_two_phase) freezes its first half in a SETUP command
+ *      (__QL_CMD__.mark_text) and only concatenates the frozen scalar with a fresh read at assert
+ *      time, so the assert stays a pure read while still proving that the value evolved across a
+ *      real harness wait and a real user tick rather than being a load-time snapshot.
+ *
+ * NO data-testid is injected anywhere in this tree. The seed already addresses every control by id
+ * (#age-btn, #activities-btn, #relation-button, #close-menu, #total-money, #balance,
+ * #head-container, #text-container, #event-title, #event-body, #menu-title, #menu-body,
+ * #menu-template, #modal-background, #create-character-screen, #death-screen, #obituary-container,
+ * #career-selector, #freetime-reading|-musicLessons|-parties|-gym, #inventory-container,
+ * #jobs-container, #cell-container, #health-bar and the other four stat bars) and every repeated
+ * row by a data-* attribute the seed writes itself (data-index / data-type / data-property /
+ * data-objname on shop and inventory rows, data-id on relationship rows, data-label on the career
+ * picker rows, data-item on the item action rows). A synthetic attribute surface would be
+ * redundant, and injecting one would add a second, parallel way to address the same element.
+ */
+(function () {
+	'use strict';
+
+	var W = window;
+	var SENTINEL = '__rb_probe_error__';
+	var DUNDER_WHITELIST = ['__QL__', '__QL_CMD__', '__RB_SEED_FACE__'];
+
+	/* ------------------------------------------------------------------ error hooks */
+	var pageErrorCount = 0;
+	var pageErrors = [];
+	function hook(name, fn) { try { W.addEventListener(name, fn); } catch (e) { /* never break the app */ } }
+	hook('error', function (e) {
+		pageErrorCount++;
+		if (pageErrors.length < 20) pageErrors.push(String((e && e.message) || 'error').slice(0, 200));
+	});
+	hook('unhandledrejection', function (e) {
+		pageErrorCount++;
+		if (pageErrors.length < 20) pageErrors.push('rejection:' + String((e && e.reason) || '').slice(0, 180));
+	});
+
+	/* ------------------------------------------------------------------ safe helpers */
+	function safe(fn) { try { var v = fn(); return v === undefined ? null : v; } catch (e) { return SENTINEL; } }
+
+	/** Read one of the seed's own top-level lexical globals by name, at call time.
+	 *  All ten application scripts are CLASSIC scripts, so their top-level const/let/class
+	 *  bindings live in the global lexical environment and are NOT window properties; an indirect
+	 *  eval resolves them exactly as a bare reference in the console would, and returns the
+	 *  sentinel instead of throwing when a repair has removed or renamed one. */
+	function gv(expr) { return safe(function () { return (0, eval)(expr); }); }
+
+	function norm(v) { return v === null || v === undefined ? '' : String(v).replace(/\s+/g, ' ').trim(); }
+	function el(sel) { try { return document.querySelector(sel); } catch (e) { return null; } }
+	function els(sel) { try { var n = document.querySelectorAll(sel); return Array.prototype.slice.call(n); } catch (e) { return []; } }
+	function byId(id) { return document.getElementById(id); }
+	function textOf(sel) { var e = el(sel); return e ? norm(e.textContent) : null; }
+	function inlineStyle(sel, prop) { var e = el(sel); return e ? norm(e.style[prop]) : null; }
+	function computedStyle(sel, prop) { var e = el(sel); return e ? norm(W.getComputedStyle(e)[prop]) : null; }
+	function attrOf(sel, name) { var e = el(sel); return e ? norm(e.getAttribute(name)) : null; }
+	function countOf(sel) { return els(sel).length; }
