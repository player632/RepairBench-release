  {
   "id": "F01",
   "kind": "static",
   "partition": "F2P",
   "source_ac_id": "D01",
   "title": "首屏主题模式：html 的 class 与 localStorage 里的 theme.mode 都该是暗色",
   "setup": [
    {
     "action": "goto",
     "target": "/"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 1200
    },
    {
     "action": "js_eval",
     "expr": "(function(){return new Promise(function(res){var t0=Date.now();function p(){var ok=false;try{ok=!!(document.querySelector('app-sidebar nav')&&!document.querySelector('app-root svg.animate-spin'));}catch(e){ok=false;}if(ok||Date.now()-t0>25000){res(ok?1:0);}else{setTimeout(p,100);}}p();});})()"
    }
   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "document.documentElement.className",
     "expected": "dark"
    },
    {
     "type": "js_eval",
     "target": "page",
     "expr": "(function(){var v=localStorage.getItem(\"theme\");if(v===null)return '<no-key>';try{return JSON.parse(v).mode;}catch(e){return '<parse-error>';}})()",
     "expected": "dark"
    }
   ]
  },
  {
   "id": "F02",
   "kind": "static",
   "partition": "F2P",
   "source_ac_id": "D02",
   "title": "登录页「Sign in」按钮的类名 token 数（cx 的分隔符）",
   "setup": [
    {
     "action": "goto",
     "target": "/auth/sign-in"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 1200
    },
    {
     "action": "js_eval",
     "expr": "(function(){return new Promise(function(res){var t0=Date.now();function p(){var ok=false;try{ok=!!(document.querySelectorAll('app-button').length===4&&!document.querySelector('app-root svg.animate-spin'));}catch(e){ok=false;}if(ok||Date.now()-t0>25000){res(ok?1:0);}else{setTimeout(p,100);}}p();});})()"
    }
   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "(function(){var b=(function(){var bs=document.querySelectorAll('app-button');for(var i=0;i<bs.length;i++){if(bs[i].textContent.trim()===\"Sign in\"){var b=bs[i].querySelector('button');if(b)return b;}}return null;})();if(!b)return 'no-button';return b.className.trim().split(/\\s+/).filter(Boolean).length;})()",
     "expected": 19
    }
   ]
  },
