+	// ---- RepairBench instrumentation bridge (design-time observation surface) ----
+	// Added by environment/instrumentation.patch. It publishes READ-ONLY access to this page's own
+	// pure helpers plus a per-key getter over the reactive state the page already keeps, under
+	// window.__rb, so the graded checkpoints can observe the compression-settings arithmetic that the
+	// UI otherwise only reveals after a real multi-minute encode. It changes no behaviour: every entry
+	// is either a reference to a function this page already defines or a getter that reads state this
+	// page already maintains, and __rb.meta() is a FIXED design-time input record (not application
+	// data). It is not an answer key: it exposes exactly the same values to the answering model that
+	// the application computes for itself, faulty or repaired alike.
+	if (typeof window !== 'undefined') {
+		(window as any).__rb = {
+			probe: 'rb-instrumentation-bridge/v1',
+			fmtSize: formatFileSize,
+			fmtDuration: formatDuration,
+			fmtRemaining: formatTimeRemaining,
+			reso: calculateOptimalResolution,
+			settings: calculateCompressionSettings,
+			threads: getOptimalThreadCount,
+			chromium: isChromiumByFeatures,
+			meta: (over?: Record<string, unknown>) => ({
+				duration: 120,
+				bitrate: 8000,
+				resolution: '3840x2160',
+				codec: 'h264',
+				size: 120000000,
+				fps: 60,
+				hasMotion: true,
+				...(over || {})
+			}),
+			targets: (i: number, k: 'label' | 'value' | 'description') => compressionTargets[i]?.[k] ?? null,
+			targetCount: () => compressionTargets.length,
+			get: (k: string) =>
+				({
+					isLoaded,
+					isProcessing,
+					progress,
+					muteSound,
+					audioOnlyMode,
+					preserveOriginalFps,
+					trimVideo,
+					skipFirstSeconds,
+					skipLastSeconds,
+					selectedTargetValue,
+					selectedTargetLabel: selectedTarget?.label ?? null,
+					selectedTargetBytes: selectedTarget?.value ?? null,
+					originalSize,
+					compressedSize,
+					hasFile: !!selectedFile,
+					fileName: selectedFile?.name ?? null,
+					errorMessage,
+					message,
+					showAdvancedSettings,
+					compressionRatio,
+					isFileSmallerThanTarget
+				})[k as never] ?? null
+		};
+	}
 </script>
 
