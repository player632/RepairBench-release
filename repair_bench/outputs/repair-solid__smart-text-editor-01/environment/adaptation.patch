+            if (event.key == "ArrowLeft") {
+                if (!this.matches("[data-open]"))
+                    return;
+                if (event.target.matches(".sub-list[data-open] > .option")) {
+                    this.close(event.target.closest(".sub-list"));
+                    return;
+                }
+                if (event.target.matches(".sub-list > .list .option")) {
