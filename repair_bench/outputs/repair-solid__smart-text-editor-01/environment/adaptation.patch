+    }
+    /**
+     * Opens the top-level list within the menu.
+     *
+     * @param section This is used internally to open specific lists within the menu.
+    */
+    open(section = this) {
+        const list = (section == this)
+            ? this.main
+            : section.querySelector(".list");
