@@ -0,0 +1,106 @@
+/* app/vendor/main.css - local fallback theme (adaptation-owned).
+   demo.productionready.io/main.css was unreachable at build time (HTTP 404),
+   so this minimal stylesheet covers the Conduit layout classes used by the
+   app. Verification asserts text/attributes/counts, never pixels. */
+
+* { box-sizing: border-box; }
+body { margin: 0; font-family: "Source Sans Pro", "Segoe UI", Arial, sans-serif; color: #373a3c; line-height: 1.5; }
+a { color: #5cb85c; text-decoration: none; }
+a:hover { text-decoration: underline; }
+h1 { font-size: 1.6rem; margin: 0.5rem 0; }
+h4 { margin: 0.5rem 0; }
+p { margin: 0.5rem 0; }
+hr { border: 0; border-top: 1px solid rgba(0,0,0,.1); margin: 1rem 0; }
+
+.container { max-width: 960px; margin: 0 auto; padding: 0 15px; }
+.row { display: flex; flex-wrap: wrap; margin: 0 -15px; }
+.row > [class*="col-"] { padding: 0 15px; }
+.col-md-3 { flex: 0 0 25%; max-width: 25%; }
+.col-md-6 { flex: 0 0 50%; max-width: 50%; }
+.col-md-8 { flex: 0 0 66.6667%; max-width: 66.6667%; }
+.col-md-9 { flex: 0 0 75%; max-width: 75%; }
+.col-md-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }
+.col-md-12, .col-xs-12 { flex: 0 0 100%; max-width: 100%; }
+.offset-md-1 { margin-left: 8.3333%; }
+.offset-md-2 { margin-left: 16.6667%; }
+.offset-md-3 { margin-left: 25%; }
+.pull-xs-right { float: right; }
+.text-xs-center { text-align: center; }
+
+.navbar { padding: 0.5rem 0; border-bottom: 1px solid rgba(0,0,0,.1); }
+.navbar .container { display: flex; align-items: center; }
+.navbar-brand { font-size: 1.3rem; font-weight: 700; color: #5cb85c !important; margin-right: 1rem; }
+.nav { display: flex; list-style: none; margin: 0; padding: 0; }
+.nav-item { margin-left: 0.25rem; }
+.nav-link { display: block; padding: 0.3rem 0.6rem; color: rgba(0,0,0,.3); }
+.nav-link.active { color: rgba(0,0,0,.8); }
+.nav-pills .nav-link { border: 1px solid transparent; border-radius: 0.25rem; }
+.nav-pills .nav-link.active { background: #5cb85c; color: #fff; }
+
+.banner { background: #333; color: #fff; padding: 1.5rem 0; margin-bottom: 1rem; }
+.banner h1 { text-shadow: 0 1px 2px rgba(0,0,0,.4); font-size: 2rem; margin: 0; }
+.banner p { color: #fff; margin: 0.25rem 0 0; }
+.article-page .banner { background: transparent; color: inherit; padding: 2rem 0 0; }
+.article-page .banner h1 { text-shadow: none; color: inherit; }
+
+.home-page { padding: 1rem 0; min-height: 50vh; }
+.article-preview { border: 1px solid rgba(0,0,0,.125); border-radius: 0.25rem; padding: 1rem; margin-bottom: 1rem; background: #fff; }
+.article-meta { display: flex; align-items: center; margin-bottom: 0.75rem; font-size: 0.85rem; color: #999; }
+.article-meta img { width: 32px; height: 32px; border-radius: 50%; margin-right: 0.5rem; }
+.article-meta .info { margin-right: 1rem; }
+.article-meta .author { display: block; color: #5cb85c; }
+.preview-link { display: block; color: inherit; }
+.preview-link h1 { font-size: 1.3rem; }
+.preview-link .tag-list { list-style: none; display: flex; flex-wrap: wrap; padding: 0; margin: 0.5rem 0 0; }
+.tag-default { display: inline-block; background: #818a91; color: #fff; border-radius: 10rem; padding: 0.1rem 0.6rem; font-size: 0.8rem; margin: 0.1rem; }
+.tag-pill { border-radius: 10rem; }
+.tag-outline { background: transparent; color: #aaa; border: 1px solid #ddd; }
+.tag-list .tag-pill i { cursor: pointer; margin-right: 0.25rem; }
+
+.btn { display: inline-block; padding: 0.35rem 0.75rem; font-size: 1rem; border-radius: 0.25rem; border: 1px solid transparent; cursor: pointer; background: transparent; color: #5cb85c; border-color: #5cb85c; }
+.btn-primary { background: #5cb85c; border-color: #5cb85c; color: #fff; }
+.btn-outline-primary { color: #5cb85c; border-color: #5cb85c; background: transparent; }
+.btn-outline-primary.active, .btn-outline-primary:hover { background: #5cb85c; color: #fff; }
+.btn-outline-secondary { color: #666; border-color: #ccc; }
+.btn-outline-danger { color: #b85c5c; border-color: #b85c5c; }
+.btn-sm { padding: 0.2rem 0.5rem; font-size: 0.85rem; }
+.btn-lg { padding: 0.6rem 1.2rem; font-size: 1.15rem; }
+.btn .counter { font-size: 0.8em; }
+
+.pagination { display: flex; list-style: none; padding: 0; margin: 1rem 0; }
+.page-item .page-link { display: block; padding: 0.3rem 0.7rem; border: 1px solid #ddd; color: #5cb85c; }
+.page-item.active .page-link { background: #5cb85c; color: #fff; border-color: #5cb85c; }
+
+.form-control { display: block; width: 100%; padding: 0.5rem 0.75rem; font-size: 1rem; border: 1px solid rgba(0,0,0,.15); border-radius: 0.25rem; margin-bottom: 0.25rem; }
+.form-control-lg { padding: 0.75rem 1rem; }
+fieldset { border: 0; padding: 0; margin: 0 0 0.75rem; }
+.form-group { margin-bottom: 1rem; }
+textarea.form-control { min-height: 6rem; }
+
+.card { border: 1px solid rgba(0,0,0,.125); border-radius: 0.25rem; margin-bottom: 1rem; background: #fff; }
+.card-block { padding: 1rem; }
+.card-footer { padding: 0.75rem 1rem; border-top: 1px solid rgba(0,0,0,.125); display: flex; align-items: center; }
+.comment-author-img { width: 24px; height: 24px; border-radius: 50%; margin-right: 0.5rem; }
+.comment-author { color: #5cb85c; }
+.date-posted { margin-left: auto; color: #999; font-size: 0.8rem; }
+
+.error-messages { list-style: none; padding: 0; margin: 0 0 1rem; color: #b85c5c; }
+.error-messages li { margin-bottom: 0.25rem; }
+
+.sidebar { background: #f3f3f3; border-radius: 0.25rem; padding: 0.75rem; }
+.sidebar p { font-weight: 700; margin-top: 0; }
+.sidebar .tag-list { display: flex; flex-wrap: wrap; }
+.sidebar .tag-default { background: #818a91; margin: 0.15rem; cursor: pointer; }
+
+.user-info { background: #f3f3f3; padding: 2rem 0; margin-bottom: 1rem; text-align: center; }
+.user-img { width: 64px; height: 64px; border-radius: 50%; }
+.action-btn { margin-top: 0.5rem; }
+
+.articles-toggle { margin-bottom: 1rem; }
+.feed-toggle { margin-bottom: 1rem; }
+.article-content { margin: 1.5rem 0; }
+.settings-page, .auth-page, .editor-page, .profile-page { padding: 1rem 0; }
+
+footer { border-top: 1px solid rgba(0,0,0,.1); padding: 1rem 0; margin-top: 2rem; background: #f3f3f3; }
+footer .logo-font { color: #5cb85c; font-weight: 700; margin-right: 0.5rem; }
+footer .attribution { color: #bbb; font-size: 0.85rem; }
