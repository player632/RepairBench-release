+      } catch (e) {
+        return SENTN;
+      }
+    },
+    setupFirstLeafLabel(): string {
+      try {
+        const l = leafButtons();
+        return l.length ? leafLabel(l[0]) : SENT;
+      } catch (e) {
+        return SENT;
+      }
+    },
+    selectedChipCount(): number {
+      return selectedCount();
+    },
+    chipCensus(): string {
+      try {
+        return chipLabels().join('|');
+      } catch (e) {
