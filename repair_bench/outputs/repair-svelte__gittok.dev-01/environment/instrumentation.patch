+      } catch (e) {
+        return SENT;
+      }
+    },
+    storedTopicCount(): number {
+      try {
+        const t = storedTopics();
+        return t == null ? SENTN : t.length;
+      } catch (e) {
+        return SENTN;
+      }
+    },
+    storedTopicCensus(): string {
+      try {
+        const t = storedTopics();
+        return t == null ? 'nostorage' : t.join('|');
+      } catch (e) {
