+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>summernote repair host</title>
+  <link rel="stylesheet" href="/summernote-lite.css">
+  <style>
+    body { margin: 24px; font-family: sans-serif; }
+    #sn-host { max-width: 900px; }
+  </style>
+</head>
+<body>
+  <div id="sn-host">
+    <textarea id="sn-editor"></textarea>
+  </div>
+  <script src="/vendor/jquery.min.js"></script>
+  <script src="/summernote-lite.js"></script>
+  <script src="/host-app.js"></script>
+</body>
+</html>
