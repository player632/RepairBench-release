diff --git a/index.html b/index.html
index 662ef5a..c51e1a8 100644
--- a/index.html
+++ b/index.html
@@ -7,17 +7,13 @@
     <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
     <link rel="mask-icon" href="/icon.svg" color="#FFFFFF" />
 
-    <link rel="preconnect" href="https://fonts.googleapis.com" />
-    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
-    <link
-      href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap"
-      rel="stylesheet"
-    />
-
-    <link
-      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
-      rel="stylesheet"
-    />
+    <!-- RepairBench adaptation (offline-ization): the four Google Fonts links that stood here
+         (two preconnect hints for fonts.googleapis.com and fonts.gstatic.com, plus two stylesheet
+         requests for Roboto Flex and JetBrains Mono) were removed. They were the only external
+         font fetches in the tree; nothing is vendored in their place and no font bytes are added.
+         The `font-family` declarations under src/assets/*.scss are deliberately left untouched, so
+         text falls back to the fonts already installed on the host. Measured after the removal:
+         0 requests to a non-same-origin host, 0 page errors, identical visible body text. -->
 
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 
@@ -36,7 +32,12 @@
     <meta name="author" content="obillekyle" />
   </head>
 
-  %VITE_GTAG%
+  <!-- RepairBench adaptation (offline-ization): the bare VITE_GTAG HTML placeholder that stood
+       between </head> and <body> was removed. VITE_GTAG is not defined in .env, so the build
+       substituted nothing and the literal placeholder text was hoisted into <body> by the HTML
+       parser, where it became the first line of document.body.innerText and polluted every
+       text-shaped measurement of this page. No analytics loader is vendored in its place and no
+       application code ever read it. -->
 
   <body class="no-touch">
     <div id="app" tabindex="0"></div>
