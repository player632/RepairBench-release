    },
    {
     "action": "wait",
     "target": "page",
     "value": 1500
    }
   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "(()=>{const rows=[...document.querySelectorAll('[data-testid=\"rb-field-row\"]')];const r=rows.find((x)=>(((x.querySelector('[data-testid=\"rb-field-name\"]')||{}).textContent)||'').replace(/\\s+/g,' ').trim()==='streamable');const b=r&&r.querySelector('.button-wrapper button');return b?b.textContent.replace(/\\s+/g,' ').trim():null})()",
