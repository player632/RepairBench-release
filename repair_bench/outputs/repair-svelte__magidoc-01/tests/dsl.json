   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "(()=>{const t=[...document.querySelectorAll('[data-testid=\"rb-search-result\"]')].find((x)=>x.getAttribute('href')==='/queries/streamable');if(!t)return null;const kids=[...t.childNodes];const bi=kids.findIndex((k)=>k.nodeName==='BR');const region=bi>=0?kids.slice(bi+1):kids;return region.map((k)=>k.textContent||'').join('').replace(/\\s+/g,' ').trim()})()",
     "expected": "delay in milliseconds for subsequent results, for d ..."
    },
