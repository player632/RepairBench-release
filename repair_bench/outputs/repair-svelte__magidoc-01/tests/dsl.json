     "expr": "(()=>{const rows=[...document.querySelectorAll('[data-testid=\"rb-field-row\"]')];const r=rows.find((x)=>(((x.querySelector('[data-testid=\"rb-field-name\"]')||{}).textContent)||'').replace(/\\s+/g,' ').trim()==='streamable');const b=r&&r.querySelector('.button-wrapper button');if(!b)return 'nobtn';b.click();return 'clicked'})()"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 900
    },
    {
     "action": "js_eval",
     "target": "page",
