     "type": "js_eval",
     "target": "page",
     "expr": "(()=>{const t=[...document.querySelectorAll('[data-testid=\"rb-search-result\"]')].find((x)=>x.getAttribute('href')==='/queries/streamable');return t?[...t.querySelectorAll('mark')].map((m)=>m.textContent).join('|'):null})()",
