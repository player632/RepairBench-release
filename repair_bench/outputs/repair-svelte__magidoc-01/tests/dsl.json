  {
   "id": "F01",
   "kind": "interaction",
   "partition": "F2P",
   "source_ac_id": "D01",
   "title": "navigating from one query page to another through the sidebar re-seeds the example generator instead of carrying the previous page query over",
   "setup": [
    {
     "action": "goto",
     "target": "/queries/person"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 1500
    },
    {
     "action": "click",
     "target": "rb-btn-increase"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 900
    },
    {
     "action": "click",
     "target": "href=/queries/test"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 2500
    }
   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "location.pathname",
     "expected": "/queries/test"
    },
    {
     "type": "js_eval",
     "target": "page",
     "expr": "((document.querySelector('[data-testid=\"rb-example-depth\"]')||{}).textContent||'').replace(/\\s+/g,' ').trim()",
     "expected": "3"
    },
    {
     "type": "js_eval",
     "target": "page",
     "expr": "((()=>{const p=document.querySelectorAll('.bx--tab-content')[0];if(!p)return null;const c=p.querySelector('pre code')||p.querySelector('code')||p.querySelector('pre');return c?c.textContent.replace(/\\s+/g,' ').trim():null})()||'').slice(0,23)",
     "expected": "query ( $string: String"
    }
   ]
  },
  {
   "id": "F02",
   "kind": "interaction",
   "partition": "F2P",
   "source_ac_id": "D02",
   "title": "the depth control stops at the documented minimum of two and refuses to go below it",
