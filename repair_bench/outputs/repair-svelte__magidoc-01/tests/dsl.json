    {
     "type": "js_eval",
     "target": "page",
     "expr": "document.querySelectorAll('.bx--tab-content').length",
     "expected": 3
    }
   ]
  },
  {
   "id": "F03",
   "kind": "static",
   "partition": "F2P",
   "source_ac_id": "D03",
   "title": "the Response example is the object the query returns, wrapped under the name of the field it asks for",
   "setup": [
    {
     "action": "goto",
     "target": "/queries/person"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 2200
    }
   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "(()=>{try{return Object.keys(JSON.parse((()=>{const p=document.querySelectorAll('.bx--tab-content')[2];if(!p)return null;const c=p.querySelector('pre code')||p.querySelector('code')||p.querySelector('pre');return c?c.textContent.replace(/\\s+/g,' ').trim():null})())).join(',')}catch(e){return 'PARSE_ERROR'}})()",
     "expected": "person"
    },
    {
     "type": "js_eval",
     "target": "page",
     "expr": "(()=>{try{JSON.parse((()=>{const p=document.querySelectorAll('.bx--tab-content')[2];if(!p)return null;const c=p.querySelector('pre code')||p.querySelector('code')||p.querySelector('pre');return c?c.textContent.replace(/\\s+/g,' ').trim():null})());return 'json'}catch(e){return 'notjson'}})()",
     "expected": "json"
    }
   ]
  },
  {
   "id": "F04",
   "kind": "static",
   "partition": "F2P",
   "source_ac_id": "D04",
   "title": "the Response tab shows the response and not a second copy of the Variables tab",
   "setup": [
    {
     "action": "goto",
     "target": "/queries/person"
    },
    {
     "action": "wait",
     "target": "page",
     "value": 2200
    }
   ],
   "asserts": [
    {
     "type": "js_eval",
     "target": "page",
     "expr": "(()=>{const a=(()=>{const p=document.querySelectorAll('.bx--tab-content')[1];if(!p)return null;const c=p.querySelector('pre code')||p.querySelector('code')||p.querySelector('pre');return c?c.textContent.replace(/\\s+/g,' ').trim():null})();const b=(()=>{const p=document.querySelectorAll('.bx--tab-content')[2];if(!p)return null;const c=p.querySelector('pre code')||p.querySelector('code')||p.querySelector('pre');return c?c.textContent.replace(/\\s+/g,' ').trim():null})();return (a!==null&&a===b)?'same':'different'})()",
     "expected": "different"
    },
    {
     "type": "js_eval",
     "target": "page",
     "expr": "(()=>{try{JSON.parse((()=>{const p=document.querySelectorAll('.bx--tab-content')[1];if(!p)return null;const c=p.querySelector('pre code')||p.querySelector('code')||p.querySelector('pre');return c?c.textContent.replace(/\\s+/g,' ').trim():null})());return 'json'}catch(e){return 'notjson'}})()",
     "expected": "json"
    }
   ]
  },
