@@ -1,2 +1,23 @@
 packages:
-  - 'packages/*'
\ No newline at end of file
+  - 'packages/*'
+# heavy-phase build recipe migration (pnpm >= 10.14 ignores the package.json pnpm field):
+# canvas must never build (native); esbuild/vue-demi postinstall explicitly allowed;
+# @jridgewell/gen-mapping pinned per feasibility recipe.
+neverBuiltDependencies:
+  - canvas
+onlyBuiltDependencies:
+  - esbuild
+  - vue-demi
+overrides:
+  '@jridgewell/gen-mapping': 0.3.5
+# security policy (pnpm >= 10.14): the delivered lockfile is part of the trusted base;
+# skip supply-chain re-verification and disable the minimum-release-age guard so the
+# pinned lockfile installs reproducibly regardless of registry-side publication age.
+minimumReleaseAge: 0
+trustLockfile: true
+# pnpm 11 build-approval model (strictDepBuilds is the v11 default): canvas is
+# explicitly denied (native), esbuild/vue-demi postinstall explicitly approved.
+allowBuilds:
+  canvas: false
+  esbuild: true
+  vue-demi: true
