+function readoutOf(sheets: any[]): any {
+  const out: any = { sheets: [], cells: {} };
+  for (const sh of sheets || []) {
+    out.sheets.push({ name: sh.name, id: sh.id, row: sh.row, column: sh.column });
+    const grid = sh.data || [];
