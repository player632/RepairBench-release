+// Copyright (C) 2026 Aron Sommer. See LICENSE file for full license details.
+
+// [ADAPTATION] Offline provisioning of the seed's own local config slot.
+// The pristine tree ships js/secrets.js.example and .gitignore:3 ("js/secrets.js"), so the real
+// js/secrets.js is NOT in the snapshot. js/main.js:85 hard-gates initApp() on
+//   typeof googleApiKey === "undefined" || typeof mapboxAccessToken === "undefined" ||
+//   typeof osmClientId === "undefined"
+// and bails out with a "Configuration Error" dialog, leaving every control unwired. This file is
+// the copy the seed's own README asks for ("Copy this file and rename it to 'secrets.js'"), with
+// every key left empty exactly as the template ships them: the drawing / editing / import / export
+// surface this task measures needs no key, and the key-consuming features are all remote services
+// that task.toml forbids at runtime (allow_internet = false). Nothing here stands in for a core
+// feature - it only satisfies a config-presence check with the template's own empty strings.
+
+// Service API Keys
+const googleApiKey = "";
+const mapboxAccessToken = "";
+const osmClientId = "";
+
+// Strava Integration (Optional)
+// Leave these empty to have users provide their own keys in the UI
+const stravaClientId = "";
+const stravaClientSecret = "";
