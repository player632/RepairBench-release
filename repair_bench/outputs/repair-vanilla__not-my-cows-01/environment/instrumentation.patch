+      if (o.dead !== undefined) c.dead = o.dead
+      if (o.x_speed !== undefined) c.x_speed = o.x_speed
+      if (o.switch_dur !== undefined) c.switch_dur = o.switch_dur
+      return i
+    },
+    killCowsBut: function (keep) {
