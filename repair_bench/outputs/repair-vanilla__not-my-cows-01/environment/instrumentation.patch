+  }
+  var frame = function () { tracker++; setGameState(tracker) }
+  var ALL_KEYS = ['ArrowRight', 'ArrowLeft', 'ArrowUp', 'Space', 'KeyD', 'KeyA', 'Enter']
+
+  var state = {
+    get score () { return score },
+    get scoreSinceMark () { return marks.score === null ? null : score - marks.score },
