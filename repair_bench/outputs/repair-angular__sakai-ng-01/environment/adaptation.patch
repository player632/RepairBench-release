diff --git a/src/assets/styles.scss b/src/assets/styles.scss
new file mode 100644
index 0000000..e4a5409
--- /dev/null
+++ b/src/assets/styles.scss
@@ -1,0 +1,21 @@
+/* RepairBench adaptation stub (ADAPTATION-A).
+ *
+ * The seed declares src/assets as a git submodule (.gitmodules:2 ->
+ *   [submodule "src/assets"] path = src/assets, url = .../sakai-ng-assets.git)
+ *
+ * while angular.json build.options.styles still lists
+ *   "src/assets/styles.scss" and "src/assets/tailwind.css".
+ * Without these two files `ng build` fails before compiling a single component,
+ * which would degrade all 12 defects to setup_failure (G-build death).
+ *
+ * This stub is deliberately RULE-FREE: it adds 0 CSS declarations, so the
+ * production budget (angular.json: initial maximumWarning 1mb / maximumError 5mb)
+ * cannot be tripped. Consequence, registered in meta.adaptation: every layout-*
+ * class and every Tailwind utility has NO styling in the served build, so all
+ * 47 checkpoints read class TOKENS / DOM counts / textContent / input.value /
+ * js_eval scalars and NONE of them asserts visibility or geometry.
+ * PrimeNG component CSS is unaffected: app.config.ts:13 runs
+ *   providePrimeNG({ theme: { preset: Aura, options: { darkModeSelector: '.app-dark' } } })
+ * and @primeuix/themes injects the .p-* component styles from JS at runtime.
+ */
+
diff --git a/src/assets/tailwind.css b/src/assets/tailwind.css
new file mode 100644
index 0000000..4520d8f
--- /dev/null
+++ b/src/assets/tailwind.css
@@ -1,0 +1,6 @@
+/* RepairBench adaptation stub (ADAPTATION-A) - see src/assets/styles.scss.
+ * Rule-free on purpose: .postcssrc.json wires @tailwindcss/postcss, and a file
+ * without `@import "tailwindcss";` makes that plugin emit nothing, which keeps
+ * the initial bundle at 0 CSS bytes (ADAPTATION-D budget risk avoided).
+ */
+
