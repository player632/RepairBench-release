+    diffKeys: (): string => safeS(() => joinList(Object.keys(diff()).sort())),
+    diffHasKey: (key: string): number => safeN(() => (Object.prototype.hasOwnProperty.call(diff(), String(key)) ? 1 : 0)),
+
