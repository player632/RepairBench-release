+    }
+  },
+  sessionStorageKeyList: (): string => {
+    try {
+      return joinList(Object.keys(sessionStorage));
+    } catch {
+      return NA;
+    }
+  },
+  ownGlobals: (): string => {
+    try {
+      return joinList(Object.keys(window).filter((k) => k.startsWith('__')));
+    } catch {
+      return NA;
+    }
+  },
+
+  /* ---- gui form (home) ---- */
