+        <tr>
+          <td>
+            <a
+              [routerLink]="collection.routerLink"
+              queryParamsHandling="preserve"
+              class="link gap-1 flex items-center"
+            >
+              <lab-icon
+                [value]="ids[0]"
+                [type]="collection.iconType"
+              ></lab-icon>
+              {{ collection.label | translate }}
+            </a>
+          </td>
+          <td>
+            {{ count }}
+          </td>
+        </tr>
+      }
+    }
+  </tbody>
+</table>
