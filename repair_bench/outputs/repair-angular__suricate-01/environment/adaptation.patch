+/* --------------------------------------------------------------- url helpers */
+
+interface ParsedRequest {
+	path: string;
+	query: URLSearchParams;
+	segments: string[];
+}
+
+function parseRequest(url: string): ParsedRequest {
+	const withoutOrigin = url.replace(/^[a-zA-Z][a-zA-Z0-9+.-]*:\/\/[^/]+/, '');
+	const questionMark = withoutOrigin.indexOf('?');
+	const path = (questionMark >= 0 ? withoutOrigin.substring(0, questionMark) : withoutOrigin).replace(/\/+$/, '');
+	const query = new URLSearchParams(questionMark >= 0 ? withoutOrigin.substring(questionMark + 1) : '');
+	return { path, query, segments: path.split('/').filter((segment: string) => segment.length > 0) };
+}
+
+function sortValue(item: any, propertyPath: string): any {
+	return propertyPath.split('.').reduce((current: any, key: string) => (current === null || current === undefined ? current : current[key]), item);
+}
+
+function applySort(items: any[], sortParameters: string[]): any[] {
+	if (!sortParameters || sortParameters.length === 0) {
+		return items;
+	}
+	const tokens: string[] = [];
+	sortParameters.forEach((parameter: string) => parameter.split(',').forEach((token: string) => tokens.push(token)));
+	if (tokens.length === 0) {
+		return items;
+	}
+	const direction = tokens[tokens.length - 1].toLowerCase() === 'desc' ? -1 : 1;
+	const properties = tokens.slice(0, tokens.length - 1);
+	if (properties.length === 0) {
+		return items;
+	}
+	return items.slice().sort((left: any, right: any) => {
+		for (const property of properties) {
+			const leftValue = sortValue(left, property);
+			const rightValue = sortValue(right, property);
+			if (leftValue === rightValue) {
+				continue;
+			}
+			if (leftValue === null || leftValue === undefined) {
+				return -1 * direction;
+			}
+			if (rightValue === null || rightValue === undefined) {
+				return 1 * direction;
+			}
+			if (typeof leftValue === 'number' && typeof rightValue === 'number') {
+				return (leftValue - rightValue) * direction;
+			}
+			return String(leftValue).localeCompare(String(rightValue)) * direction;
+		}
+		return 0;
+	});
+}
+
+function applySearch(items: any[], search: string): any[] {
+	if (!search) {
+		return items;
+	}
+	const needle = search.toLowerCase();
+	const matches = (value: any): boolean => {
+		if (value === null || value === undefined) {
+			return false;
+		}
+		if (Array.isArray(value)) {
+			return value.some((entry: any) => matches(entry));
+		}
+		if (typeof value === 'object') {
+			return Object.keys(value).some((key: string) => key !== 'password' && matches(value[key]));
+		}
+		return String(value).toLowerCase().includes(needle);
+	};
+	return items.filter((item: any) => matches(item));
+}
+
+function paginate(items: any[], query: URLSearchParams): any {
+	const size = Number(query.get('size') || '10');
+	const page = Number(query.get('page') || '0');
+	const sortParameters = query.getAll('sort');
+	const sorted = applySort(items, sortParameters);
+	const start = page * size;
+	return {
+		content: clone(sorted.slice(start, start + size)),
+		page: { number: page, size, totalElements: sorted.length }
+	};
+}
+
+function filtered(items: any[], query: URLSearchParams): any {
+	return paginate(applySearch(clone(items), query.get('search')), query);
+}
