+/* --------------------------------------------------------------------- router */
+
+function handle(request: any, parsed: ParsedRequest): Observable<HttpEvent<any>> {
+	const method = String(request.method).toUpperCase();
+	const rest = parsed.segments.slice(1); // drop the leading 'api' segment
+	const version = rest[0];
+	const resource = rest[1];
+	const tail = rest.slice(2);
+	const query = parsed.query;
+	const body = request.body;
+
+	if (version !== 'v1') {
+		return errorResponse(404, 'not.found', request.url);
+	}
+
+	/* ---------------------------------------------------------- configurations */
+	if (resource === 'configurations' || resource === 'category-parameters') {
+		if (resource === 'configurations' && tail[0] === 'authentication-providers') {
+			return respond(['DATABASE', 'GITHUB', 'GITLAB'], 200, request.url);
+		}
+		if (tail.length === 0) {
+			if (method === 'GET') {
+				return respond(filtered(state.configurations, query), 200, request.url);
+			}
+			if (method === 'POST') {
+				const created = {
+					key: body && body.key ? body.key : 'configuration-' + (state.configurations.length + 1),
+					value: body ? body.value : '',
+					description: body && body.description ? body.description : '',
+					export: body ? !!body.export : true,
+					dataType: body && body.dataType ? body.dataType : 'TEXT',
+					category: category(1),
+					showValue: body ? !!body.showValue : true
+				};
+				state.configurations.push(created);
+				return respond(created, 201, request.url);
+			}
+		}
+		const key = decodeURIComponent(tail[0]);
+		const index = state.configurations.findIndex((entry: any) => entry.key === key);
+		if (method === 'GET') {
+			return index >= 0 ? respond(state.configurations[index], 200, request.url) : errorResponse(404, 'not.found', request.url);
+		}
+		if (method === 'PUT') {
+			if (index >= 0 && body) {
+				state.configurations[index].value = body.value;
+			}
+			return emptyResponse(204, request.url);
+		}
+		if (method === 'DELETE') {
+			if (index >= 0) {
+				state.configurations.splice(index, 1);
+			}
+			return emptyResponse(204, request.url);
+		}
+	}
+
+	/* -------------------------------------------------------------- categories */
+	if (resource === 'categories') {
+		if (tail.length === 2 && tail[1] === 'widgets') {
+			const categoryId = Number(tail[0]);
+			return respond(clone(state.widgets.filter((entry: any) => entry.category.id === categoryId)), 200, request.url);
+		}
+		return respond(filtered(CATEGORIES, query), 200, request.url);
+	}
+
+	/* ------------------------------------------------------------------ roles */
+	if (resource === 'roles') {
+		return respond(filtered(ROLES, query), 200, request.url);
+	}
+
+	/* ---------------------------------------------------------------- settings */
+	if (resource === 'settings') {
+		return respond(clone(SETTINGS), 200, request.url);
+	}
+
+	/* -------------------------------------------------------------------- auth */
+	if (resource === 'auth') {
+		const user = state.users.find(
+			(candidate: any) => candidate.username === (body ? body.username : '') && candidate.password === (body ? body.password : '')
+		);
+		if (!user) {
+			return errorResponse(401, 'authentication.bad.credentials', request.url);
+		}
+		return respond({ accessToken: issueToken(user) }, 200, request.url);
+	}
+
+	/* ------------------------------------------------------------------ users */
+	if (resource === 'users') {
+		if (tail.length === 0) {
+			if (method === 'GET') {
+				return respond(filtered(state.users.map(publicUser), query), 200, request.url);
+			}
+			if (method === 'POST') {
+				const exists = state.users.some((candidate: any) => candidate.username === (body ? body.username : ''));
+				if (exists) {
+					return errorResponse(400, 'user.username.duplicate', request.url);
+				}
+				const created = {
+					id: state.nextUserId++,
+					username: body.username,
+					firstname: body.firstname,
+					lastname: body.lastname,
+					email: body.email,
+					avatarUrl: null as string,
+					mode: 'DATABASE',
+					password: body.password,
+					roles: body.roles && body.roles.length ? clone(body.roles) : [role('ROLE_USER')]
+				};
+				state.users.push(created);
+				return respond(publicUser(created), 201, request.url);
+			}
+		}
+		if (tail[0] === 'signup' && method === 'POST') {
+			const exists = state.users.some((candidate: any) => candidate.username === (body ? body.username : ''));
+			if (exists) {
+				return errorResponse(400, 'user.username.duplicate', request.url);
+			}
+			const created = {
+				id: state.nextUserId++,
+				username: body.username,
+				firstname: body.firstname,
+				lastname: body.lastname,
+				email: body.email,
+				avatarUrl: null as string,
+				mode: 'DATABASE',
+				password: body.password,
+				roles: [role('ROLE_USER')]
+			};
+			state.users.push(created);
+			return respond(publicUser(created), 201, request.url);
+		}
+		if (tail[0] === 'personal-access-token') {
+			if (method === 'GET') {
+				return respond(clone(state.tokens), 200, request.url);
+			}
+			if (method === 'POST') {
+				const name = body ? body.name : '';
+				if (state.tokens.some((entry: any) => entry.name === name)) {
+					return errorResponse(400, 'settings.security.token.created.duplicated.name', request.url);
+				}
+				const created = { name, value: 'sur_pat_' + Math.abs(hashCode(name)).toString(36), createdDate: new Date().toISOString() };
+				state.tokens.push({ name: created.name, value: null, createdDate: created.createdDate });
+				return respond(created, 201, request.url);
+			}
+			if (method === 'DELETE') {
+				const name = decodeURIComponent(tail[1]);
+				const index = state.tokens.findIndex((entry: any) => entry.name === name);
+				if (index >= 0) {
+					state.tokens.splice(index, 1);
+				}
+				return emptyResponse(204, request.url);
+			}
+		}
+		const identifier = decodeURIComponent(tail[0]);
+		if (tail[1] === 'settings') {
+			if (method === 'GET') {
+				return respond(clone(userSettingsOf(identifier)), 200, request.url);
+			}
+			if (method === 'PUT') {
+				const settingId = Number(tail[2]);
+				const settings = userSettingsOf(identifier);
+				const entry = settings.find((candidate: any) => candidate.setting.id === settingId);
+				if (entry && body) {
+					if (body.allowedSettingValueId) {
+						entry.settingValue = clone(entry.setting.allowedSettingValues.find((value: any) => value.id === body.allowedSettingValueId));
+					} else {
+						entry.unconstrainedValue = body.unconstrainedValue;
+					}
+				}
+				return emptyResponse(204, request.url);
+			}
+		}
+		const byName = state.users.find((candidate: any) => candidate.username === identifier);
+		const byId = state.users.find((candidate: any) => String(candidate.id) === identifier);
+		const target = byId || byName;
+		if (method === 'GET') {
+			return target ? respond(publicUser(target), 200, request.url) : errorResponse(404, 'not.found', request.url);
+		}
+		if (method === 'PUT') {
+			if (target && body) {
+				target.firstname = body.firstname !== undefined ? body.firstname : target.firstname;
+				target.lastname = body.lastname !== undefined ? body.lastname : target.lastname;
+				target.email = body.email !== undefined ? body.email : target.email;
+				if (body.password) {
+					target.password = body.password;
+				}
+				if (body.roles && body.roles.length) {
+					target.roles = clone(body.roles);
+				}
+			}
+			return emptyResponse(204, request.url);
+		}
+		if (method === 'DELETE') {
+			const index = state.users.findIndex((candidate: any) => target && candidate.id === target.id);
+			if (index >= 0) {
+				state.users.splice(index, 1);
+			}
+			return emptyResponse(204, request.url);
+		}
+	}
+
+	/* ------------------------------------------------------------- admin users */
+	if (resource === 'admin' && tail[0] === 'users') {
+		return respond(filtered(state.users.map(publicUser), query), 200, request.url);
+	}
+
+	/* ---------------------------------------------------------------- projects */
+	if (resource === 'projects') {
+		if (tail[0] === 'currentUser') {
+			return respond(clone(state.projects), 200, request.url);
+		}
+		if (tail.length === 0) {
+			if (method === 'GET') {
+				return respond(filtered(state.projects, query), 200, request.url);
+			}
+			if (method === 'POST') {
+				return respond(createProject(body || {}), 201, request.url);
+			}
+		}
+		const token = decodeURIComponent(tail[0]);
+		const index = state.projects.findIndex((candidate: any) => candidate.token === token);
+		if (tail.length === 1) {
+			if (method === 'GET') {
+				return index >= 0 ? respond(state.projects[index], 200, request.url) : errorResponse(404, 'not.found', request.url);
+			}
+			if (method === 'PUT') {
+				if (index >= 0 && body) {
+					state.projects[index].name = body.name !== undefined ? body.name : state.projects[index].name;
+					state.projects[index].gridProperties.maxColumn = body.maxColumn || state.projects[index].gridProperties.maxColumn;
+					state.projects[index].gridProperties.widgetHeight = body.widgetHeight || state.projects[index].gridProperties.widgetHeight;
+					state.projects[index].gridProperties.cssStyle = body.cssStyle || '';
+				}
+				return emptyResponse(204, request.url);
+			}
+			if (method === 'DELETE') {
+				if (index >= 0) {
+					state.projects.splice(index, 1);
+				}
+				return emptyResponse(204, request.url);
+			}
+		}
+		if (tail[1] === 'users') {
+			if (method === 'GET') {
+				return respond(clone(PROJECT_USERS), 200, request.url);
+			}
+			if (method === 'POST') {
+				const user = state.users.find((candidate: any) => candidate.username === (body ? body.username : ''));
+				if (user) {
+					PROJECT_USERS.push({ id: user.id, username: user.username, firstname: user.firstname, lastname: user.lastname });
+				}
+				return emptyResponse(201, request.url);
+			}
+			if (method === 'DELETE') {
+				const userId = Number(tail[2]);
+				const position = PROJECT_USERS.findIndex((candidate: any) => candidate.id === userId);
+				if (position >= 0) {
+					PROJECT_USERS.splice(position, 1);
+				}
+				return emptyResponse(204, request.url);
+			}
+		}
+		if (tail[1] === 'websocket' && tail[2] === 'clients') {
+			return respond([], 200, request.url);
+		}
+		if (tail[1] === 'screenshot' || tail[1] === 'projectWidgetPositions') {
+			return emptyResponse(204, request.url);
+		}
+	}
+
+	/* ----------------------------------------------------------------- widgets */
+	if (resource === 'widgets') {
+		if (tail.length === 0) {
+			return respond(filtered(state.widgets, query), 200, request.url);
+		}
+		const widgetId = Number(tail[0]);
+		const index = state.widgets.findIndex((candidate: any) => candidate.id === widgetId);
+		if (method === 'GET') {
+			return index >= 0 ? respond(state.widgets[index], 200, request.url) : errorResponse(404, 'not.found', request.url);
+		}
+		if (method === 'PUT') {
+			if (index >= 0 && body && body.widgetAvailability) {
+				state.widgets[index].widgetAvailability = body.widgetAvailability;
+			}
+			return emptyResponse(204, request.url);
+		}
+		if (method === 'DELETE') {
+			if (index >= 0) {
+				state.widgets.splice(index, 1);
+			}
+			return emptyResponse(204, request.url);
+		}
+	}
+
+	/* ------------------------------------------------------------ repositories */
+	if (resource === 'repositories') {
+		if (tail.length === 0) {
+			if (method === 'GET') {
+				return respond(filtered(state.repositories, query), 200, request.url);
+			}
+			if (method === 'POST') {
+				const created = Object.assign({ id: state.nextRepositoryId++, createdDate: new Date().toISOString() }, clone(body || {}));
+				state.repositories.push(created);
+				return respond(created, 201, request.url);
+			}
+		}
+		if (tail[0] === 'synchronize') {
+			return emptyResponse(204, request.url);
+		}
+		const repositoryId = Number(tail[0]);
+		const index = state.repositories.findIndex((candidate: any) => candidate.id === repositoryId);
+		if (method === 'GET') {
+			return index >= 0 ? respond(state.repositories[index], 200, request.url) : errorResponse(404, 'not.found', request.url);
+		}
+		if (method === 'PUT') {
+			if (index >= 0 && body) {
+				state.repositories[index] = Object.assign(clone(state.repositories[index]), clone(body));
+			}
+			return emptyResponse(204, request.url);
+		}
+		if (method === 'DELETE') {
+			if (index >= 0) {
+				state.repositories.splice(index, 1);
+			}
+			return emptyResponse(204, request.url);
+		}
+	}
+
+	/* ----------------------------------------------------------- project grids */
+	if (resource === 'projectGrids') {
+		const token = decodeURIComponent(tail[0]);
+		const project = state.projects.find((candidate: any) => candidate.token === token);
+		if (tail.length === 1) {
+			if (method === 'POST') {
+				const grid = { id: state.nextGridId++, time: body ? body.time : 10 };
+				if (project) {
+					project.grids.push(grid);
+				}
+				return respond(grid, 201, request.url);
+			}
+			if (method === 'PUT') {
+				if (project && body && body.grids) {
+					project.grids = clone(body.grids).map((grid: any) => ({ id: grid.id, time: grid.time }));
+					project.displayProgressBar = !!body.displayProgressBar;
+				}
+				return emptyResponse(204, request.url);
+			}
+		}
+		if (tail.length === 2) {
+			const gridId = Number(tail[1]);
+			const grid = project ? project.grids.find((candidate: any) => candidate.id === gridId) : undefined;
+			if (method === 'GET') {
+				return grid ? respond(clone(grid), 200, request.url) : errorResponse(404, 'not.found', request.url);
+			}
+			if (method === 'DELETE') {
+				if (project) {
+					project.grids = project.grids.filter((candidate: any) => candidate.id !== gridId);
+				}
+				return emptyResponse(204, request.url);
+			}
+		}
+	}
+
+	/* -------------------------------------------------------- project widgets */
+	if (resource === 'projectWidgets') {
+		if (tail.length === 2 && tail[1] === 'projectWidgets') {
+			return respond(clone(state.projectWidgets.filter((entry: any) => entry.projectToken === decodeURIComponent(tail[0]))), 200, request.url);
+		}
+		if (tail.length === 3 && tail[2] === 'projectWidgets') {
+			const created = projectWidget(state.nextProjectWidgetId++, decodeURIComponent(tail[0]), Number(tail[1]), body ? body.widgetId : 0, 0, 0);
+			state.projectWidgets.push(created);
+			return respond(created, 201, request.url);
+		}
+		if (tail.length === 1) {
+			const projectWidgetId = Number(tail[0]);
+			const index = state.projectWidgets.findIndex((candidate: any) => candidate.id === projectWidgetId);
+			if (method === 'GET') {
+				return index >= 0 ? respond(state.projectWidgets[index], 200, request.url) : errorResponse(404, 'not.found', request.url);
+			}
+			if (method === 'PUT') {
+				if (index >= 0 && body) {
+					state.projectWidgets[index] = Object.assign(clone(state.projectWidgets[index]), clone(body));
+				}
+				return respond(index >= 0 ? state.projectWidgets[index] : null, 200, request.url);
+			}
+			if (method === 'DELETE') {
+				if (index >= 0) {
+					state.projectWidgets.splice(index, 1);
+				}
+				return emptyResponse(204, request.url);
+			}
+		}
+	}
+
+	/* ----------------------------------------------------------------- screens */
+	if (resource === 'screens') {
+		const token = decodeURIComponent(tail[0]);
+		const action = tail[1];
+		if (action === 'connect') {
+			state.screens[token] = Number(query.get('screenCode') || '0');
+			return emptyResponse(204, request.url);
+		}
+		if (action === 'disconnect') {
+			delete state.screens[token];
+			return emptyResponse(204, request.url);
+		}
+		return emptyResponse(204, request.url);
+	}
+
+	/* ------------------------------------------------------------------ assets */
+	if (resource === 'assets') {
+		return emptyResponse(404, request.url);
+	}
+
+	return errorResponse(404, 'not.found', request.url);
+}
+
+function hashCode(value: string): number {
+	let hash = 0;
+	for (let index = 0; index < value.length; index++) {
+		hash = (hash * 31 + value.charCodeAt(index)) | 0;
+	}
+	return hash;
+}
+
+/* --------------------------------------------------------------- interceptor */
+
+export const offlineBackendInterceptor: HttpInterceptorFn = (request: any, next: any): Observable<HttpEvent<any>> => {
+	const parsed = parseRequest(String(request.url || ''));
+	if (!parsed.path.startsWith(API_PREFIX + '/')) {
+		return next(request);
+	}
+	return handle(request, parsed);
+};
