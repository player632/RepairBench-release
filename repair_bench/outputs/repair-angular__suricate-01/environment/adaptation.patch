+
+function respond(body: any, status = 200, url = ''): Observable<HttpEvent<any>> {
+	return of(new HttpResponse<any>({ body: clone(body), status, url })).pipe(delay(0));
+}
+
+function errorResponse(status: number, key: string, url = ''): Observable<HttpEvent<any>> {
+	return throwError(() => new HttpErrorResponse({ error: { key }, status, statusText: 'Error', url })).pipe(delay(0));
+}
+
+function emptyResponse(status = 200, url = ''): Observable<HttpEvent<any>> {
+	return of(new HttpResponse<any>({ body: null, status, url })).pipe(delay(0));
+}
