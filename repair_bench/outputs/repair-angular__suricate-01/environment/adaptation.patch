+function issueToken(user: any): string {
+	const header = { alg: 'none', typ: 'JWT' };
+	const payload = {
+		sub: user.username,
+		email: user.email,
+		firstname: user.firstname,
+		lastname: user.lastname,
+		avatar_url: user.avatarUrl || '',
+		mode: user.mode || 'DATABASE',
+		roles: (user.roles || []).map((entry: any) => entry.name),
+		iat: Math.floor(Date.now() / 1000),
+		exp: Math.floor(Date.now() / 1000) + 86400
+	};
+	const encode = (value: any) => btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(value)))).replace(/=+$/, '');
+	return encode(header) + '.' + encode(payload) + '.offline-signature';
+}
