-  parseClipboardContent(clipboardContent) {
-    const parsedData = [];
-
-    // first we need to figure out how many rows we need to paste
-    const rows = clipboardContent.split('\n');
-
-    // for each row parse cell data
-    let i = 0;
-    rows.forEach((row) => {
-      parsedData[i] = row.split('\t');
-      i += 1;
-    });
-    return parsedData;
-  }
