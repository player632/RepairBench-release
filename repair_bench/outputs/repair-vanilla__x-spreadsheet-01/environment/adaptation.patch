+  const { moreBtns, contentEl } = moreEl.dd;
+  el.css('width', `${this.widthFn()}px`);
+  const elBox = el.box();
+
+  let sumWidth = 160;
+  let sumWidth2 = 12;
+  const list1 = [];
+  const list2 = [];
+  btns2.forEach(([it, w], index) => {
+    sumWidth += w;
+    if (index === btns2.length - 1 || sumWidth < elBox.width) {
+      list1.push(it);
+    } else {
+      sumWidth2 += w;
+      list2.push(it);
+    }
+  });
+  btns.html('').children(...list1);
+  moreBtns.html('').children(...list2);
+  contentEl.css('width', `${sumWidth2}px`);
+  if (list2.length > 0) {
+    moreEl.show();
+  } else {
+    moreEl.hide();
+  }
+}
+
+function genBtn(it) {
+  const btn = new Item();
+  btn.el.on('click', () => {
+    if (it.onClick) it.onClick(this.data.getData(), this.data);
+  });
+  btn.tip = it.tip || '';
+
+  let { el } = it;
+
+  if (it.icon) {
+    el = h('img').attr('src', it.icon);
+  }
