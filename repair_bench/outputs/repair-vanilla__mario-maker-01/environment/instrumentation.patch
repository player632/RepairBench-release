+    if (root.querySelectorAll) {
+      var kids = root.querySelectorAll('td, div, canvas, button, table');
+      for (var i = 0; i < kids.length; i++) { nodes.push(kids[i]); }
+    }
+    for (var n = 0; n < nodes.length; n++) {
+      var el = nodes[n];
+      if (!el || el.nodeType !== 1) { continue; }
+      if (el.tagName === 'TD') {
