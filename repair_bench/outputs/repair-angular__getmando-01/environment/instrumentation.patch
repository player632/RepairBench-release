-async function collectTestFiles(rootDir, currentDir = rootDir) {
-  const entries = await readdir(currentDir, { withFileTypes: true });
-  const files = [];
-
-  for (const entry of entries) {
-    if (entry.isDirectory()) {
-      if (IGNORED_DIRECTORIES.has(entry.name)) {
