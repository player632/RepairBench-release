diff --git a/assets/css/icons-offline.css b/assets/css/icons-offline.css
new file mode 100644
index 0000000000000000000000000000000000000000..92227b44f616bbc7626185df477e1a732f30a271
--- /dev/null
+++ b/assets/css/icons-offline.css
@@ -0,0 +1,16 @@
+/* Offline stand-in for the dropped remote icon-font stylesheet.
+ * Box metrics only: the icon classes keep a 1em inline-block box so the icon-only controls
+ * (menu toggle, menu close, theme toggle, carousel arrows, panel arrows, the small pictograms
+ * beside every service and contact line) keep their geometry and stay clickable. No glyph
+ * artwork is invented and no webfont is referenced: a binary font does not belong in a text
+ * patch and nothing may leave the machine (task.toml [environment] allow_internet = false). */
+[class^="uil"],
+[class*=" uil"] {
+  display: inline-block;
+  width: 1em;
+  height: 1em;
+  line-height: 1;
+  font-style: normal;
+  text-align: center;
+  vertical-align: middle;
+}
diff --git a/assets/css/style.css b/assets/css/style.css
index 3961f38e229056e7b9226531f4a6e9ea088f0ca4..6333f7b18511c53a2805dd2ffdf8f58cfca56eba 100644
--- a/assets/css/style.css
+++ b/assets/css/style.css
@@ -1,5 +1,7 @@
 /*==================== GOOGLE FONTS ====================*/
-@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap");
+/* the remote web font is dropped by the offline adaptation: a binary webfont does not belong
+   in a text patch and nothing may leave the machine. --body-font already ends in sans-serif, so
+   the page falls back to the local sans-serif stack and no layout mechanism changes. */
 
 /*==================== VARIABLES CSS ====================*/
 :root {
