+// ---------------------------------------------------------------------------
+// RepairBench adaptation (offline determinism, fixture layer only).
+//
+// Upstream generated this mock data set with Math.random() and anchored
+// `registered_at` to `new Date()`, so every page load produced a different
+// list (different ages / groups / roles / active flags) and a different set of
+// registration dates depending on the day the app happened to be opened. The
+// demo still behaves identically - same 24 records, same fields, same
+// "age is a uniform integer in [1,100]", same "group/role/active are a uniform
+// pick from the same option arrays", same "one record per day, most recent
+// first" - but the draws now come from a seeded mulberry32 stream anchored to a
+// fixed local epoch, so the fixture is byte-identical on every load and on
+// every machine. No application logic is touched: this file is the mock
+// backend's seed data, not part of the framework under test.
+// ---------------------------------------------------------------------------
+const FIXTURE_SEED_START = 0x5eed1a7e
+let fixtureSeed = FIXTURE_SEED_START
+
+function fixtureRandom() {
+    fixtureSeed = (fixtureSeed + 0x6d2b79f5) | 0
+    let t = fixtureSeed
+    t = Math.imul(t ^ (t >>> 15), t | 1)
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61)
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
+}
+
+// Fixed local-time epoch (17 May 2024). `getFormattedDate` below reads
+// getDate/getMonth/getFullYear, so the anchor is built from local components
+// rather than an ISO string to stay timezone-independent.
+const FIXTURE_EPOCH = new Date(2024, 4, 17)
+
 function getRegisteredDate(idx: number) {
-    const currentDate = new Date()
+    const currentDate = new Date(FIXTURE_EPOCH.getTime())
     currentDate.setDate(currentDate.getDate() - idx)
     return getFormattedDate(currentDate)
 }
