+/*
+ *
+ * Static BPMN documents handed to the app's OWN import path (lf.render(xml) ->
+ * Adapter.adapterIn -> xml2Json -> convertBpmn2LfData). They are written in exactly
+ * the shape this app's own exporter (Adapter.adapterOut) emits, so importing them
+ * never depends on anything the seed does not already produce. Every id, attribute
+ * and coordinate is fixed, which is what makes the graded readings deterministic.
+ * Generated from src/rb/fixtures/*.xml (well-formedness checked with a real XML
+ * parser; Flow_a2's name is authored as &#10; so the parsed value is "route\nalpha").
+ */
+
+/** a - fix_a_task.xml: startEvent -> userTask(=assignee, groups, users, dueDate, followUpDate, 2 zeebe properties, documentation) -> endEvent; Flow_a2 has a two-line name; one definitions-level bpmn:message with a zeebe:subscription correlationKey */
+export const FIX_A = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions id=\"Definitions_fix_a\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:zeebe=\"http://camunda.org/schema/zeebe/1.0\" xmlns:modeler=\"http://camunda.org/schema/modeler/1.0\" targetNamespace=\"http://bpmn.io/schema/bpmn\" xmlns:bioc=\"http://bpmn.io/schema/bpmn/biocolor/1.0\" xmlns:color=\"http://bpmn.io/schema/bpmn/biocolor/1.0\" exporter=\"logicflow\" exporterVersion=\"1.2.0\" modeler:executionPlatform=\"Camunda Cloud\" modeler:executionPlatformVersion=\"8.2.0\">\n  <bpmn:process isExecutable=\"true\" id=\"Process_fix_a\">\n    <bpmn:startEvent id=\"Event_start_1\" name=\"Start\">\n      <bpmn:extensionElements>\n        <zeebe:properties />\n      </bpmn:extensionElements>\n      <bpmn:outgoing>Flow_a1</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:userTask id=\"Activity_review_1\" name=\"Review order\" assignee=\"=order.total\" candidateGroups=\"sales\" candidateUsers=\"kermit,piggy\" dueDate=\"2024-05-01T09:30:00\" followUpDate=\"2024-05-02T18:00:00\">\n      <bpmn:documentation>Escalate when the order total is high.</bpmn:documentation>\n      <bpmn:extensionElements>\n        <zeebe:properties>\n          <zeebe:property name=\"region\" value=\"emea\" />\n          <zeebe:property name=\"tier\" value=\"gold\" />\n        </zeebe:properties>\n      </bpmn:extensionElements>\n      <bpmn:incoming>Flow_a1</bpmn:incoming>\n      <bpmn:outgoing>Flow_a2</bpmn:outgoing>\n    </bpmn:userTask>\n    <bpmn:endEvent id=\"Event_end_1\" name=\"Done\">\n      <bpmn:extensionElements>\n        <zeebe:properties />\n      </bpmn:extensionElements>\n      <bpmn:incoming>Flow_a2</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_a1\" sourceRef=\"Event_start_1\" targetRef=\"Activity_review_1\">\n      <bpmn:extensionElements>\n        <zeebe:properties />\n      </bpmn:extensionElements>\n    </bpmn:sequenceFlow>\n    <bpmn:sequenceFlow id=\"Flow_a2\" sourceRef=\"Activity_review_1\" targetRef=\"Event_end_1\" name=\"route&#10;alpha\">\n      <bpmn:extensionElements>\n        <zeebe:properties />\n      </bpmn:extensionElements>\n    </bpmn:sequenceFlow>\n  </bpmn:process>\n  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_fix_a\">\n      <bpmndi:BPMNShape id=\"Event_start_1_di\" bpmnElement=\"Event_start_1\">\n        <dc:Bounds x=\"180\" y=\"200\" width=\"36\" height=\"36\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"155\" y=\"233\" width=\"50\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Activity_review_1_di\" bpmnElement=\"Activity_review_1\" bioc:stroke=\"#0d4372\" bioc:fill=\"#bbdefb\" color:background-color=\"#bbdefb\" color:border-color=\"#0d4372\">\n        <dc:Bounds x=\"420\" y=\"200\" width=\"100\" height=\"80\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"370\" y=\"247\" width=\"100\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Event_end_1_di\" bpmnElement=\"Event_end_1\">\n        <dc:Bounds x=\"660\" y=\"200\" width=\"36\" height=\"36\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"640\" y=\"233\" width=\"40\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNEdge id=\"Flow_a1_di\" bpmnElement=\"Flow_a1\">\n        <di:waypoint x=\"198\" y=\"200\" />\n        <di:waypoint x=\"370\" y=\"200\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_a2_di\" bpmnElement=\"Flow_a2\">\n        <di:waypoint x=\"470\" y=\"200\" />\n        <di:waypoint x=\"642\" y=\"200\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"520\" y=\"180\" width=\"50\" height=\"14\" />\n        </bpmndi:BPMN