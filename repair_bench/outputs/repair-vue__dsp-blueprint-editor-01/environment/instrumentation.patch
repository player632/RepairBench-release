+/* eslint-disable */
+// rb-probe/1 - a neutral, read-only measurement probe.
+//
+// Added by environment/instrumentation.patch as src/rb-probe.ts and imported as the FIRST line of
+// src/main.ts, so every wrapper below is installed before any application module body runs.
+//
+// What it does, exhaustively:
+//   1. publishes boot and live scalars on window.__rb (every getter returns a STRING);
+//   2. clears localStorage / sessionStorage once at boot, so a checkpoint can never inherit state;
+//   3. defensively unregisters service workers, deletes caches, and replaces
+//      navigator.serviceWorker.register with an inert resolver (see the PWA note below);
+//   4. wraps window.fetch / XMLHttpRequest.prototype.open / navigator.sendBeacon / window.open and
+//      the src setter of img / iframe / script / source, classifying every url as same-origin or
+//      egress, and counts cross-origin entries in performance resource timing;
+//   5. counts uncaught errors and unhandled rejections.
+//
+// What it never does: it renders nothing, creates no element, adds no data-testid, holds no
+// selector / constant / expectation belonging to any defect, mutates no application state, and
+// reads no blueprint data. It cannot make a broken behaviour pass, and it cannot make a working
+// behaviour fail: every scalar it publishes is a COUNT of traffic the application itself initiated.
+//
+// PWA note: the seed registers `${process.env.BASE_URL}service-worker.js` from src/swStatus.vue:23
+// in every non-development build, and @vue/cli-plugin-pwa emits a workbox precache over the whole
+// emitted asset set. Left alone, the first page load would install a controller that serves every
+// later checkpoint from that precache, which is a cross-run determinism hazard rather than a
+// defect. Item 3 above removes the hazard; it touches no defect landing and no code path that any
+// checkpoint reads as an application behaviour.
+//
+// The eslint disable is required because @vue/cli-plugin-eslint runs during `vue-cli-service build`
+// (vue.config.js sets no lintOnSave, so the default applies) and an eslint ERROR fails the build.
+// Every line is also written to type-check under tsconfig.json strict:true, because
+// fork-ts-checker type errors fail the same build.
+
+const w = window as any;
+const nav = navigator as any;
+
+const state = {
+    egress: 0,
+    same: 0,
+    resourceEgress: 0,
+    swRegisterCalls: 0,
+    errors: 0,
+};
+const hosts: string[] = [];
+
+function classify(raw: unknown): string {
+    let text = '';
+    if (typeof raw === 'string') text = raw;
+    else if (raw && typeof (raw as any).url === 'string') text = (raw as any).url;
+    else return 'skip';
+    if (!text) return 'skip';
+    try {
+        const url = new URL(text, window.location.href);
+        if (url.protocol !== 'http:' && url.protocol !== 'https:') return 'skip';
+        if (url.origin === window.location.origin) return 'same';
+        if (hosts.indexOf(url.host) < 0) hosts.push(url.host);
+        return 'egress';
+    } catch (e) {
+        return 'skip';
+    }
+}
+
+function note(raw: unknown): void {
+    const kind = classify(raw);
+    if (kind === 'same') state.same += 1;
+    else if (kind === 'egress') state.egress += 1;
+}
+
+// ---- 4a. request APIs -----------------------------------------------------------------------
+if (typeof w.fetch === 'function') {
+    const nativeFetch = w.fetch.bind(window);
+    w.fetch = function (input: any, init?: any) {
+        note(input);
+        return nativeFetch(input, init);
+    };
+}
+
+const xhrProto: any = w.XMLHttpRequest && w.XMLHttpRequest.prototype ? w.XMLHttpRequest.prototype : null;
+if (xhrProto && typeof xhrProto.open === 'function') {
+    const nativeOpen = xhrProto.open;
+    xhrProto.open = function (this: any, ...args: any[]) {
+        note(args[1]);
+        return nativeOpen.apply(this, args);
+    };
+}
+
+if (typeof nav.sendBeacon === 'function') {
+    const nativeBeacon = nav.sendBeacon.bind(navigator);
+    nav.sendBeacon = function (url: any, data?: any) {
+        note(url);
+        return nativeBeacon(url, data);
+    };
+}
+
+// window.open is counted and then refused: a probe that let the call through would itself create
+// the cross-origin navigation it is supposed to be measuring. The seed has zero window.open call
+// sites (mechanism-side census: `window.open(` hits 0 in src/**), so this wrapper is inert.
+w.open = function (...args: any[]) {
+    note(args[0]);
+    return null;
+};
+
+// ---- 4b. subresource src setters (not covered by fetch/XHR) ----------------------------------
+function hookSrc(ctor: any): void {
+    if (!ctor || !ctor.prototype) return;
+    const desc = Object.getOwnPropertyDescriptor(ctor.prototype, 'src');
+    if (!desc || typeof desc.set !== 'function') return;
+    const nativeSet = desc.set;
+    Object.defineProperty(ctor.prototype, 'src', {
+        configurable: true,
+        enumerable: desc.enumerable,
+        get: desc.get,
+        set(value: any) {
+            note(value);
+            nativeSet.call(this, value);
+        },
+    });
+}
+hookSrc(w.HTMLImageElement);
+hookSrc(w.HTMLIFrameElement);
+hookSrc(w.HTMLScriptElement);
+hookSrc(w.HTMLSourceElement);
+
+// ---- 4c. resource timing (catches anything the wrappers above cannot see, e.g. CSS fonts) -----
+function scanResources(): void {
+    let n = 0;
+    try {
+        const entries = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
+        for (const entry of entries) if (classify(entry.name) === 'egress') n += 1;
+    } catch (e) {
+        n = 0;
+    }
+    state.resourceEgress = n;
+}
+
+// ---- 2. storage reset ------------------------------------------------------------------------
+try { w.localStorage.clear(); } catch (e) { /* storage may be blocked; the getter reports -1 */ }
+try { w.sessionStorage.clear(); } catch (e) { /* ditto */ }
+
+// ---- 3. service worker / cache neutralisation ------------------------------------------------
+if (nav.serviceWorker) {
+    nav.serviceWorker.register = function () {
+        state.swRegisterCalls += 1;
+        return Promise.resolve({
+            waiting: null,
+            installing: null,
+            active: null,
+            scope: '',
+            addEventListener(): void { /* inert */ },
+            removeEventListener(): void { /* inert */ },
+            unregister(): Promise<boolean> { return Promise.resolve(true); },
+        });
+    };
+    try {
+        const pending = nav.serviceWorker.getRegistrations();
+        if (pending && typeof pending.then === 'function') {
+            pending.then((list: any[]) => {
+                for (const reg of list) { try { reg.unregister(); } catch (e) { /* inert */ } }
+            }).catch(() => { /* inert */ });
+        }
+    } catch (e) { /* inert */ }
+}
+try {
+    if (w.caches && typeof w.caches.keys === 'function') {
+        w.caches.keys().then((keys: string[]) => {
+            for (const key of keys) { try { w.caches.delete(key); } catch (e) { /* inert */ } }
+        }).catch(() => { /* inert */ });
+    }
+} catch (e) { /* inert */ }
+
+// ---- 5. error counters -----------------------------------------------------------------------
+w.addEventListener('error', function () { state.errors += 1; });
+w.addEventListener('unhandledrejection', function () { state.errors += 1; });
+
+// ---- 1. published scalars (every getter returns a STRING) ------------------------------------
+const api = {
+    version: 'rb-probe/1',
+    ready: '0',
+    get egressCount(): string { return String(state.egress); },
+    get egressHosts(): string { return hosts.slice().sort().join('|'); },
+    get sameOriginCount(): string { return String(state.same); },
+    get egressResources(): string { scanResources(); return String(state.resourceEgress); },
+    get swRegisterCalls(): string { return String(state.swRegisterCalls); },
+    get errorCount(): string { return String(state.errors); },
+    get storageKeys(): string {
+        let local = -1;
+        let session = -1;
+        try { local = w.localStorage.length; } catch (e) { local = -1; }
+        try { session = w.sessionStorage.length; } catch (e) { session = -1; }
+        return String(local) + '/' + String(session);
+    },
+    get href(): string { return String(window.location.href); },
+    get hash(): string { return String(window.location.hash); },
+    get search(): string { return String(window.location.search); },
+    get pathname(): string { return String(window.location.pathname); },
+};
+w.__rb = api;
+
+function markReady(): void { api.ready = '1'; }
+if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', markReady);
+else markReady();
+w.addEventListener('load', markReady);
