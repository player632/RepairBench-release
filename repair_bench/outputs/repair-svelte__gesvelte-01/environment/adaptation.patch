diff --git a/b/static/rb-offline-notice.html b/static/rb-offline-notice.html
new file mode 100644
index 0000000..e87b9df
--- /dev/null
+++ b/static/rb-offline-notice.html
@@ -0,0 +1,54 @@
+<!DOCTYPE html>
+<html lang="en">
+	<head>
+		<meta charset="utf-8" />
+		<meta name="viewport" content="width=device-width" />
+		<meta name="robots" content="noindex" />
+		<title>Offline notice - geSvelte</title>
+		<style>
+			body {
+				margin: 0;
+				min-height: 100vh;
+				display: flex;
+				align-items: center;
+				justify-content: center;
+				background: #06012a;
+				color: #fff;
+				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+				font-size: 1.4rem;
+				line-height: 1.7;
+			}
+			main {
+				max-width: 46rem;
+				padding: 3rem 4rem;
+				border: 3px solid rgba(97, 20, 108, 0.5);
+				border-radius: 0.6rem;
+				background: rgba(255, 255, 255, 0.06);
+			}
+			h1 {
+				font-size: 2rem;
+				margin: 0 0 1rem;
+			}
+			a {
+				color: #d93acc;
+			}
+			p {
+				margin: 0 0 1rem;
+			}
+		</style>
+	</head>
+	<body>
+		<main>
+			<h1>This link leaves the app</h1>
+			<p>
+				The link you followed pointed at a third-party website. This grading face runs with the network
+				disabled, so every cross-origin link in the app has been repointed at this same-origin page
+				instead of being followed. Nothing was fetched and nothing failed: this file is served from the
+				build output like any other static asset.
+			</p>
+			<p>
+				<a href="/stage">Back to the form builder</a>
+			</p>
+		</main>
+	</body>
+</html>
