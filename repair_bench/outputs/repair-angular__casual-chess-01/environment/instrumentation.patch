+<script>
+(function () {
+  function tagEl(el) {
+    if (!el || el.nodeType !== 1) return;
+    if (el.tagName === 'PIECE' && el.cgKey) {
+      var t = 'pc-' + el.cgKey;
+      if (el.getAttribute('data-testid') !== t) el.setAttribute('data-testid', t);
+    } else if (el.tagName === 'SQUARE' && el.cgKey) {
+      var u = 'sqc-' + el.cgKey;
+      if (el.getAttribute('data-testid') !== u) el.setAttribute('data-testid', u);
+    }
+  }
+  function tagRoot(root) {
+    if (!root || !root.querySelectorAll) return;
+    var i, els = root.querySelectorAll('piece, square');
+    for (i = 0; i < els.length; i++) tagEl(els[i]);
+  }
+  function init() {
+    tagRoot(document.body);
+    var mo = new MutationObserver(function (muts) {
+      for (var k = 0; k < muts.length; k++) {
+        tagEl(muts[k].target);
+        var added = muts[k].addedNodes;
+        for (var a = 0; a < added.length; a++) {
+          if (added[a].nodeType === 1) { tagEl(added[a]); tagRoot(added[a]); }
+        }
+      }
+    });
+    mo.observe(document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['style', 'class'] });
+  }
+  if (document.body) init();
+  else document.addEventListener('DOMContentLoaded', init);
+})();
+</script>
