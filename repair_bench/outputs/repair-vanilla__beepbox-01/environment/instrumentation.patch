diff --git a/website/beepbox_offline_template.html b/website/beepbox_offline_template.html
index 384d1b5..bd880b9 100644
--- a/website/beepbox_offline_template.html
+++ b/website/beepbox_offline_template.html
@@ -250,5 +250,43 @@ if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|android|ipad|
 
 const editor = new beepbox.SongEditor(document.getElementById("beepboxEditorContainer"));
 
+// INSTRUMENTATION: read-only state bridge for repair checkpoints.
+// Always call window.__BB__() fresh for every read; never cache a snapshot
+// or the bridge function's result object across interactions.
+window.__BB__ = function () {
+	try {
+		const d = editor.doc, s = d.song;
+		return {
+			v: 1,
+			tempo: s.tempo, beatsPerBar: s.beatsPerBar, barCount: s.barCount,
+			scale: s.scale, key: s.key, rhythm: s.rhythm,
+			loopStart: s.loopStart, loopLength: s.loopLength,
+			pitchChannelCount: s.pitchChannelCount, noiseChannelCount: s.noiseChannelCount,
+			bar: d.bar, channel: d.channel,
+			playing: d.synth.playing, recording: d.synth.recording,
+			hash: window.location.hash, songString: s.toBase64String(),
+			historyLength: window.history.length,
+			channels: s.channels.map(function (c) {
+				return {
+					octave: c.octave, muted: c.muted, bars: c.bars.slice(),
+					patterns: c.patterns.map(function (p) {
+						return p.notes.map(function (n) {
+							return { start: n.start, end: n.end, pitches: n.pitches.slice(), pins: n.pins.map(function (pin) { return [pin.time, pin.size, pin.interval]; }) };
+						});
+					})
+				};
+			}),
+			instruments: s.channels.map(function (c) {
+				return c.instruments.map(function (i) {
+					return { type: i.type, preset: i.preset, volume: i.volume, operators: i.operators.map(function (o) { return { frequency: o.frequency, amplitude: o.amplitude }; }) };
+				});
+			}),
+			prefs: { volume: d.prefs.volume, autoPlay: d.prefs.autoPlay, enableChannelMuting: d.prefs.enableChannelMuting, displayBrowserUrl: d.prefs.displayBrowserUrl, enableNotePreview: d.prefs.enableNotePreview }
+		};
+	} catch (e) {
+		return { v: 1, error: String(e) };
+	}
+};
+
 	</script>
 </body></html>
