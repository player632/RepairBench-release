+      return { articles: clone(pageOf(list, query)), articlesCount: list.length };
+    }
+
+    const slug = decodeURIComponent(seg[1] || "");
+
+    if (seg.length === 2) {
+      if (method === "get") {
+        const article = findArticle(slug);
+        if (!article) return { errors: { slug: ["not found"] } };
