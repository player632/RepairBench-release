+  // ---- offline verification instrumentation: fresh-read state bridge ----
+  // Every accessor re-reads its live closure binding on each access and nothing is
+  // snapshotted, so a probe that re-reads window.__MDVIEWER__ after an interaction
+  // always observes the current application state (never a stale design-time copy).
+  window.__MDVIEWER__ = {
+    get editor() { return markdownEditor; },
+    get splitEditor() { return documentSplitEditor; },
+    get preview() { return markdownPreview; },
+    get editorPane() { return editorPaneElement; },
+    get lineNumbers() { return lineNumbers; },
+    get tabs() { return tabs; },
+    get activeTabId() { return activeTabId; },
+    get syncScrollingEnabled() { return syncScrollingEnabled; },
+    get storage() { return workspaceStorage; },
+    get stats() {
+      return {
+        chars: charCountElement ? charCountElement.textContent : null,
+        words: wordCountElement ? wordCountElement.textContent : null,
+        minutes: readingTimeElement ? readingTimeElement.textContent : null
+      };
+    },
+    setEditorValue: function (text) {
+      if (!markdownEditor) return false;
+      markdownEditor.focus();
+      markdownEditor.value = String(text);
+      markdownEditor.dispatchEvent(new Event('input', { bubbles: true }));
+      return true;
+    },
+    refreshDocumentStats: function () {
+      updateDocumentStats();
+      return true;
+    },
+    refreshLineNumbers: function () {
+      updateLineNumbers({ force: true });
+      return true;
+    },
+    persistedMetadata: function () {
+      if (!workspaceStorage) return Promise.resolve(null);
+      return workspaceStorage.init()
+        .then(function () { return workspaceStorage.listDocumentMetadata(); })
+        .then(function (records) {
+          return records.map(function (record) {
+            return {
+              id: String(record.id || ''),
+              title: String(record.title || ''),
+              keys: Object.keys(record).sort().join(','),
+              contentSize: Number(record.contentSize) || 0
+            };
+          });
+        })
+        .catch(function () { return null; });
+    }
+  };
+
+  // ---- offline verification instrumentation: stable element probes ----
+  // Additive attributes only; no selector, style or behaviour of the application
+  // depends on them, and a missing element is skipped rather than reported.
+  (function installVerificationProbes() {
+    const probes = [
+      ['#markdown-editor', 'rb-editor'],
+      ['#markdown-preview', 'rb-preview'],
+      ['#line-numbers', 'rb-line-numbers'],
+      ['#char-count', 'rb-char-count'],
+      ['#word-count', 'rb-word-count'],
+      ['#reading-time', 'rb-reading-time'],
+      ['#theme-toggle', 'rb-theme-toggle'],
+      ['#theme-toggle-icon', 'rb-theme-toggle-icon'],
+      ['#direction-toggle', 'rb-direction-toggle'],
+      ['#toggle-sync', 'rb-sync-toggle'],
+      ['#table-picker-grid', 'rb-table-picker-grid'],
+      ['#table-picker-status', 'rb-table-picker-status'],
+      ['#document-tree', 'rb-document-tree'],
+      ['#document-sidebar-count', 'rb-document-sidebar-count'],
+      ['#markdown-format-toolbar [aria-label="Bulleted list"]', 'rb-format-unordered-list'],
+      ['#markdown-format-toolbar [aria-label="Numbered list"]', 'rb-format-ordered-list']
+    ];
+    probes.forEach(function (entry) {
+      const element = document.querySelector(entry[0]);
+      if (element && !element.getAttribute('data-testid')) {
+        element.setAttribute('data-testid', entry[1]);
+      }
+    });
+  })();
+
   document.documentElement.dataset.appReady = 'true';
   window.dispatchEvent(new Event('markdown-viewer:ready'));
 });
