diff --git a/rb-offline/inert.css b/rb-offline/inert.css
new file mode 100644
--- /dev/null
+++ b/rb-offline/inert.css
@@ -0,0 +1,8 @@
+/* rb-offline/inert.css - offline stand-in installed by environment/adaptation.patch.
+   All three documents carry one stylesheet, and that stylesheet used to open with one import of a remote web-font
+   stylesheet. With no network at all that request never settles, and because a stylesheet import blocks the load
+   event of the document that carries it, every navigation would sit and wait for it. It is repointed here, at this
+   inert local file, so nothing leaves the origin. The page therefore renders in the reader's own fallback fonts:
+   that is the harness, not a fault, and it is not on the tested surface (every reading in tests/dsl.json is a text /
+   attribute / boolean / count reading, never a layout or computed-style reading).
+   It is HARNESS, not application code: it carries no rule, no selector and no behaviour. */
diff --git a/rb-offline/inert.js b/rb-offline/inert.js
new file mode 100644
--- /dev/null
+++ b/rb-offline/inert.js
@@ -0,0 +1,6 @@
+// rb-offline/inert.js - offline stand-in installed by environment/adaptation.patch.
+// Three documents in this tree used to load one remote DOM helper library from a content delivery network. The page
+// asked that library for exactly one thing: to set one property on every element carrying one class. Those two call
+// sites are rewritten in the same patch into the plain document calls that mean the same thing, so nothing is left
+// that needs the library, and this file is therefore deliberately empty of behaviour.
+// It is HARNESS, not application code: it defines no global, adds no property and changes nothing at runtime.
