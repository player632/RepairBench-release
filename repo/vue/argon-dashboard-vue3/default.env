# ALL VARIABLE MUST BE PREFIXED WITH `VITE_`
VITE_APP_VERSION=0.1.0
VITE_GOOGLE_API_KEY=
# RB-OFFLINE (adaptation.patch): the upstream value was an absolute Firebase Hosting URL.
# default.env is NOT a Vite env file - Vite loads .env / .env.[mode] from envDir (root) and
# vite.config.ts sets no envDir, and the shipped Dockerfile copies a prod.env that does not
# exist - so env("VITE_DOCUMENT_ENDPOINT") is undefined at runtime either way. This edit
# removes the last external hostname from the tree with zero observable behaviour change.
# VITE_APP_VERSION above is deliberately left untouched.
VITE_DOCUMENT_ENDPOINT=/rb-assets/docs/
