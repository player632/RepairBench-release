registry = https://registry.npmmirror.com # 镜像源
canvas_binary_host_mirror = https://registry.npmmirror.com/-/binary/canvas # canvas安装慢的问题

ignore-workspace-root-check = true
shamefully-hoist = true
strict-peer-dependencies = false
auto-install-peers = true

# security policy set in pnpm-workspace.yaml (trusted delivered lockfile).

# heavy-phase build recipe migration (pnpm >= 10.14): kebab-case fallbacks for the
# security policy set in pnpm-workspace.yaml (trusted delivered lockfile).
minimum-release-age=0
trust-lockfile=true
trust-policy=off
